<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>HmiEditor.App.UiTests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <!-- headless 平台：无需显示器/GPU 即可构建真实可视树、跑布局与输入模拟 -->
    <PackageReference Include="Avalonia.Headless" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\HmiEditor.App\HmiEditor.App.csproj" />
    <!-- 临时目录统一走 TestTempDir（探测 + 回退），不要在测试里直接 Path.GetTempPath()。 -->
    <ProjectReference Include="..\HmiEditor.TestSupport\HmiEditor.TestSupport.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="HmiEditor.TestSupport" />
  </ItemGroup>
</Project>
