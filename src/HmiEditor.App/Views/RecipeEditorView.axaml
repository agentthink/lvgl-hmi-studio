<cw:ChromeWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:HmiEditor.App.Resources"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        xmlns:cw="using:HmiEditor.App.Controls"
        x:Class="HmiEditor.App.Views.RecipeEditorView"
        Title="{res:Loc win.recipe.editor}"
        Width="900"
        Height="650"
        MinWidth="680"
        MinHeight="490"
        WindowStartupLocation="CenterOwner">
    <!-- ═══ 无边框圆角窗口外壳 ═══ -->
    <Border CornerRadius="{StaticResource HmiWindowCornerRadius}"
            BorderBrush="{StaticResource HmiWindowBorderBrush}"
            BorderThickness="{StaticResource HmiWindowBorderThickness}"
            Background="{StaticResource HmiBgWindowBrush}"
            ClipToBounds="True">
        <Grid RowDefinitions="36,*,Auto">
            <!-- 标准标题栏 -->
            <Border Grid.Row="0"
                    CornerRadius="10,10,0,0"
                    Background="{StaticResource HmiWindowTitleBgBrush}"
                    BorderBrush="{StaticResource HmiBorderBrush}"
                    BorderThickness="0,0,0,1"
                    chrome:WindowDecorationProperties.ElementRole="TitleBar"
                    PointerPressed="OnTitleBarPointerPressed">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{res:Loc win.recipe.editor}"
                               Foreground="{StaticResource HmiTextPrimaryBrush}"
                               FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="16,0,8,0"
                               TextTrimming="CharacterEllipsis"/>
                    <Button x:Name="BtnTitleClose"
                            Grid.Column="1"
                            Width="40" Height="36"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource HmiTextSecondaryBrush}"
                            CornerRadius="0,10,0,0"
                            Click="OnTitleCloseClicked"
                            chrome:WindowDecorationProperties.ElementRole="CloseButton">
                        <Path Data="{StaticResource HmiCloseGlyph}"
                              Width="10" Height="10"
                              Stretch="Uniform"
                              Stroke="{StaticResource HmiTextSecondaryBrush}"
                              StrokeThickness="1.5"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    </Button>
                </Grid>
            </Border>

            <!-- 原窗口内容整体放入此处 -->
            <Border Grid.Row="1" Padding="12">
        <Grid ColumnDefinitions="200,260,*" RowDefinitions="*">
            <!-- ════════════════════════════════════════ -->
            <!-- 左栏：配方分组列表                          -->
            <!-- ════════════════════════════════════════ -->
            <Border Background="{StaticResource HmiBgPanelBrush}" CornerRadius="6" Padding="8">
                <Grid RowDefinitions="Auto,Auto,*,Auto">
                    <!-- 标题 + 添加分组按钮 -->
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{res:Loc recipe.group.list}"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" FontSize="14" FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                        <Button x:Name="BtnAddGroup" Content="{res:Loc recipe.add.group}"
                                Grid.Column="1"
                                Background="{StaticResource HmiAccentHoverBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                BorderThickness="0" Padding="10,4"
                                FontSize="11"
                                ToolTip.Tip="{res:Loc recipe.tt.add.group}"/>
                    </Grid>

                    <!-- 空状态提示 -->
                    <TextBlock x:Name="EmptyGroupHint"
                               Text="{res:Loc recipe.no.group.hint}"
                               Foreground="{StaticResource HmiTextHintBrush}" FontSize="12"
                               Grid.Row="1" Margin="0,8,0,4"
                               HorizontalAlignment="Center"
                               IsHitTestVisible="False"/>

                    <!-- 分组列表 -->
                    <ListBox x:Name="GroupList"
                             Grid.Row="2"
                             Background="Transparent"
                             BorderThickness="0"
                             Margin="0,4,0,0"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,2"/>
                                <Setter Property="Background" Value="{StaticResource HmiBgPanelBrush}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="BorderBrush" Value="{StaticResource HmiBorderBrush}"/>
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                            <Style Selector="ListBoxItem:selected">
                                <Setter Property="Background" Value="{StaticResource HmiBgSelectedBrush}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource HmiAccentHoverBrush}"/>
                            </Style>
                        </ListBox.Styles>
                    </ListBox>

                    <!-- 删除分组按钮 -->
                    <Button x:Name="BtnDeleteGroup" Content="{res:Loc recipe.delete.group}"
                            Grid.Row="3"
                            Background="{StaticResource HmiDangerDeepBrush}" Foreground="{StaticResource HmiDangerBrush}"
                            BorderThickness="0" Padding="10,4"
                            FontSize="11" Margin="0,6,0,0"
                            ToolTip.Tip="{res:Loc recipe.tt.del.group}"/>
                </Grid>
            </Border>

            <!-- ════════════════════════════════════════ -->
            <!-- 中栏：配方列表                             -->
            <!-- ════════════════════════════════════════ -->
            <Border Grid.Column="1" Background="{StaticResource HmiBgPanelBrush}" CornerRadius="6" Padding="8"
                    Margin="8,0,0,0">
                <Grid RowDefinitions="Auto,Auto,*,Auto">
                    <!-- 标题 -->
                    <TextBlock Text="{res:Loc recipe.list}"
                               Foreground="{StaticResource HmiTextPrimaryBrush}" FontSize="14" FontWeight="Bold"
                               VerticalAlignment="Center"/>

                    <!-- 操作按钮行 -->
                    <Grid Grid.Row="1" ColumnDefinitions="*,*,*" Margin="0,6,0,4" ColumnSpacing="4">
                        <Button x:Name="BtnNewRecipe" Content="{res:Loc recipe.new}"
                                Background="{StaticResource HmiAccentHoverBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                BorderThickness="0" Padding="6,4"
                                FontSize="11"
                                ToolTip.Tip="{res:Loc recipe.tt.new}"/>
                        <Button x:Name="BtnCloneRecipe" Content="{res:Loc recipe.clone}"
                                Grid.Column="1"
                                Background="{StaticResource HmiAccentHoverBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                BorderThickness="0" Padding="6,4"
                                FontSize="11"
                                ToolTip.Tip="{res:Loc recipe.tt.clone}"/>
                        <Button x:Name="BtnDeleteRecipe" Content="{res:Loc recipe.del.param}"
                                Grid.Column="2"
                                Background="{StaticResource HmiDangerDeepBrush}" Foreground="{StaticResource HmiDangerBrush}"
                                BorderThickness="0" Padding="6,4"
                                FontSize="11"
                                ToolTip.Tip="{res:Loc recipe.tt.del.recipe}"/>
                    </Grid>

                    <!-- 配方列表 -->
                    <ListBox x:Name="RecipeList"
                             Grid.Row="2"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,2"/>
                                <Setter Property="Background" Value="{StaticResource HmiBgPanelBrush}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="BorderBrush" Value="{StaticResource HmiBorderBrush}"/>
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                            <Style Selector="ListBoxItem:selected">
                                <Setter Property="Background" Value="{StaticResource HmiBgSelectedBrush}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource HmiAccentHoverBrush}"/>
                            </Style>
                        </ListBox.Styles>
                    </ListBox>

                    <!-- 空配方提示 -->
                    <TextBlock x:Name="EmptyRecipeHint"
                               Text="{res:Loc recipe.no.recipe.hint}"
                               Foreground="{StaticResource HmiTextHintBrush}" FontSize="12"
                               Grid.Row="2"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"/>

                    <!-- CSV 操作按钮 -->
                    <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="4" Margin="0,6,0,0">
                        <Button x:Name="BtnImportCsv" Content="{res:Loc recipe.csv.import}"
                                Background="{StaticResource HmiBgDeepBrush}" Foreground="{StaticResource HmiTextSecondaryBrush}"
                                BorderThickness="1" BorderBrush="{StaticResource HmiInputBorderBrush}"
                                Padding="6,4" FontSize="11"
                                ToolTip.Tip="{res:Loc recipe.tt.import.csv}"/>
                        <Button x:Name="BtnExportCsv" Content="{res:Loc recipe.csv.export}"
                                Grid.Column="1"
                                Background="{StaticResource HmiBgDeepBrush}" Foreground="{StaticResource HmiTextSecondaryBrush}"
                                BorderThickness="1" BorderBrush="{StaticResource HmiInputBorderBrush}"
                                Padding="6,4" FontSize="11"
                                ToolTip.Tip="{res:Loc recipe.tt.export.csv}"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- ════════════════════════════════════════ -->
            <!-- 右栏：配方编辑面板                          -->
            <!-- ════════════════════════════════════════ -->
            <Border Grid.Column="2" Background="{StaticResource HmiBgPanelBrush}" CornerRadius="6" Padding="10"
                    Margin="8,0,0,0">
                <ScrollViewer Background="Transparent">
                    <StackPanel Spacing="8">
                        <!-- ======================== -->
                        <!-- 基本信息区                -->
                        <!-- ======================== -->
                        <TextBlock Text="{res:Loc recipe.basic.info}"
                                   Foreground="{StaticResource HmiTextHintBrush}" FontSize="11" FontWeight="Bold"
                                   Margin="0,0,0,2"/>

                        <!-- 配方名称 -->
                        <Grid ColumnDefinitions="64,*">
                            <TextBlock Text="{res:Loc recipe.name}"
                                       Foreground="{StaticResource HmiTextPrimaryBrush}" FontSize="12"
                                       VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtRecipeName"
                                     Grid.Column="1"
                                     Background="{StaticResource HmiBgDeepBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                     BorderBrush="{StaticResource HmiInputBorderBrush}" BorderThickness="1"
                                     Padding="6,4" FontSize="12"
                                     PlaceholderText="{res:Loc recipe.name.hint}"
                                     ToolTip.Tip="{res:Loc recipe.tt.name}"/>
                        </Grid>

                        <!-- 分组 -->
                        <Grid ColumnDefinitions="64,*">
                            <TextBlock Text="{res:Loc recipe.group.label}"
                                       Foreground="{StaticResource HmiTextPrimaryBrush}" FontSize="12"
                                       VerticalAlignment="Center"/>
                            <ComboBox x:Name="CmbRecipeGroup"
                                      Grid.Column="1"
                                      Background="{StaticResource HmiBgDeepBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                      BorderBrush="{StaticResource HmiInputBorderBrush}" BorderThickness="1"
                                      Padding="6,4" FontSize="12"
                                      ToolTip.Tip="{res:Loc recipe.tt.group}"/>
                        </Grid>

                        <!-- 描述 -->
                        <Grid ColumnDefinitions="64,*">
                            <TextBlock Text="{res:Loc recipe.desc}"
                                       Foreground="{StaticResource HmiTextPrimaryBrush}" FontSize="12"
                                       VerticalAlignment="Top" Margin="0,4,0,0"/>
                            <TextBox x:Name="TxtDescription"
                                     Grid.Column="1"
                                     Background="{StaticResource HmiBgDeepBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                     BorderBrush="{StaticResource HmiInputBorderBrush}" BorderThickness="1"
                                     Padding="6,4" FontSize="12" Height="52"
                                     AcceptsReturn="True"
                                     PlaceholderText="{res:Loc recipe.desc.hint}"
                                     ToolTip.Tip="{res:Loc recipe.tt.desc}"/>
                        </Grid>

                        <!-- 启用 + 版本号 -->
                        <Grid ColumnDefinitions="64,Auto,*,Auto">
                            <TextBlock Text="{res:Loc recipe.status}"
                                       Foreground="{StaticResource HmiTextPrimaryBrush}" FontSize="12"
                                       VerticalAlignment="Center"/>
                            <CheckBox x:Name="ChkEnabled" Content="{res:Loc recipe.enabled}"
                                      Grid.Column="1"
                                      Foreground="{StaticResource HmiTextPrimaryBrush}" FontSize="12"
                                      ToolTip.Tip="{res:Loc recipe.tt.enabled}"/>
                            <TextBlock Text="{res:Loc recipe.version}" Grid.Column="2"
                                       Foreground="{StaticResource HmiTextPrimaryBrush}" FontSize="12"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtVersion"
                                       Grid.Column="3"
                                       Foreground="{StaticResource HmiLinkBrush}" FontSize="13" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </Grid>

                        <!-- 时间信息 -->
                        <Grid ColumnDefinitions="64,*">
                            <TextBlock Text="{res:Loc recipe.created}"
                                       Foreground="{StaticResource HmiTextHintBrush}" FontSize="11"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtCreatedAt"
                                       Grid.Column="1"
                                       Foreground="{StaticResource HmiTextHintBrush}" FontSize="11"
                                       VerticalAlignment="Center"/>
                        </Grid>
                        <Grid ColumnDefinitions="64,*" Margin="0,-4,0,0">
                            <TextBlock Text="{res:Loc recipe.modified}"
                                       Foreground="{StaticResource HmiTextHintBrush}" FontSize="11"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtModifiedAt"
                                       Grid.Column="1"
                                       Foreground="{StaticResource HmiTextHintBrush}" FontSize="11"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <!-- 分隔线 -->
                        <Border Height="1" Background="{StaticResource HmiBorderBrush}" Margin="0,4"/>

                        <!-- ======================== -->
                        <!-- 配方参数区                -->
                        <!-- ======================== -->
                        <TextBlock Text="{res:Loc recipe.params}"
                                   Foreground="{StaticResource HmiTextHintBrush}" FontSize="11" FontWeight="Bold"/>

                        <!-- 参数操作按钮 -->
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="4">
                            <TextBlock Text="{res:Loc recipe.param.list}"
                                       Foreground="{StaticResource HmiTextSecondaryBrush}" FontSize="11"
                                       VerticalAlignment="Center"/>
                            <Button x:Name="BtnAddParam" Content="{res:Loc recipe.add.param}"
                                    Grid.Column="1"
                                    Background="{StaticResource HmiAccentHoverBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                    BorderThickness="0" Padding="8,3"
                                    FontSize="10"
                                    ToolTip.Tip="{res:Loc recipe.tt.add.param}"/>
                            <Button x:Name="BtnDeleteParam" Content="{res:Loc recipe.del.param}"
                                    Grid.Column="2"
                                    Background="{StaticResource HmiDangerDeepBrush}" Foreground="{StaticResource HmiDangerBrush}"
                                    BorderThickness="0" Padding="8,3"
                                    FontSize="10"
                                    ToolTip.Tip="{res:Loc recipe.tt.del.param}"/>
                            <Button x:Name="BtnMoveUp" Content="{res:Loc recipe.up.param}"
                                    Grid.Column="3"
                                    Background="{StaticResource HmiBgDeepBrush}" Foreground="{StaticResource HmiTextSecondaryBrush}"
                                    BorderThickness="1" BorderBrush="{StaticResource HmiInputBorderBrush}"
                                    Padding="8,3" FontSize="10"
                                    ToolTip.Tip="{res:Loc recipe.tt.up.param}"/>
                        </Grid>

                        <!-- 参数表格列表 -->
                        <ListBox x:Name="ParamList"
                                 Background="Transparent"
                                 BorderThickness="1" BorderBrush="{StaticResource HmiBorderBrush}"
                                 CornerRadius="4" MaxHeight="160"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Padding" Value="6,4"/>
                                    <Setter Property="Margin" Value="0,1"/>
                                    <Setter Property="Background" Value="{StaticResource HmiBgDeepBrush}"/>
                                    <Setter Property="CornerRadius" Value="2"/>
                                </Style>
                                <Style Selector="ListBoxItem:selected">
                                    <Setter Property="Background" Value="{StaticResource HmiBgSelectedBrush}"/>
                                </Style>
                            </ListBox.Styles>
                        </ListBox>

                        <!-- 参数表格表头 -->
                        <Grid ColumnDefinitions="28,*,*,56,40,40,40"
                              Margin="0,0,0,0" ColumnSpacing="2">
                            <TextBlock Text="{res:Loc recipe.sort.no}" Foreground="{StaticResource HmiTextMutedBrush}" FontSize="9"/>
                            <TextBlock Text="{res:Loc trend.label}" Grid.Column="1"
                                       Foreground="{StaticResource HmiTextMutedBrush}" FontSize="9"/>
                            <TextBlock Text="{res:Loc trend.var.id}" Grid.Column="2"
                                       Foreground="{StaticResource HmiTextMutedBrush}" FontSize="9"/>
                            <TextBlock Text="{res:Loc recipe.param.default}" Grid.Column="3"
                                       Foreground="{StaticResource HmiTextMutedBrush}" FontSize="9"/>
                            <TextBlock Text="{res:Loc recipe.param.unit}" Grid.Column="4"
                                       Foreground="{StaticResource HmiTextMutedBrush}" FontSize="9"/>
                            <TextBlock Text="{res:Loc trend.min}" Grid.Column="5"
                                       Foreground="{StaticResource HmiTextMutedBrush}" FontSize="9"/>
                            <TextBlock Text="{res:Loc trend.max}" Grid.Column="6"
                                       Foreground="{StaticResource HmiTextMutedBrush}" FontSize="9"/>
                        </Grid>

                        <!-- 下移按钮行 -->
                        <Button x:Name="BtnMoveDown" Content="{res:Loc recipe.down.param}"
                                Background="{StaticResource HmiBgDeepBrush}" Foreground="{StaticResource HmiTextSecondaryBrush}"
                                BorderThickness="1" BorderBrush="{StaticResource HmiInputBorderBrush}"
                                Padding="8,3" FontSize="10"
                                HorizontalAlignment="Left"
                                ToolTip.Tip="{res:Loc recipe.tt.down.param}"/>

                        <!-- ======================== -->
                        <!-- 参数编辑面板              -->
                        <!-- ======================== -->
                        <Border x:Name="ParamEditPanel"
                                Background="{StaticResource HmiBgDeepBrush}" CornerRadius="4"
                                BorderThickness="1" BorderBrush="{StaticResource HmiBorderBrush}"
                                Padding="8" IsVisible="False">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{res:Loc recipe.param.edit}"
                                           Foreground="{StaticResource HmiTextHintBrush}" FontSize="10" FontWeight="Bold"/>

                                <!-- 标签 -->
                                <Grid ColumnDefinitions="56,*">
                                    <TextBlock Text="{res:Loc recipe.param.label}"
                                               Foreground="{StaticResource HmiTextPrimaryBrush}" FontSize="11"
                                               VerticalAlignment="Center"/>
                                    <TextBox x:Name="TxtParamLabel"
                                             Grid.Column="1"
                                             Background="{StaticResource HmiBgDeepBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                             BorderBrush="{StaticResource HmiInputBorderBrush}" BorderThickness="1"
                                             Padding="6,3" FontSize="12"
                                             PlaceholderText="{res:Loc recipe.param.label.hint}"
                                             ToolTip.Tip="{res:Loc recipe.tt.param.label}"/>
                                </Grid>

                                <!-- 变量 ID -->
                                <Grid ColumnDefinitions="56,*">
                                    <TextBlock Text="{res:Loc recipe.param.var.id}"
                                               Foreground="{StaticResource HmiTextPrimaryBrush}" FontSize="11"
                                               VerticalAlignment="Center"/>
                                    <ComboBox x:Name="CmbParamVariable"
                                              Grid.Column="1"
                                              Background="{StaticResource HmiBgDeepBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                              BorderBrush="{StaticResource HmiInputBorderBrush}" BorderThickness="1"
                                              Padding="6,3" FontSize="12"
                                              ToolTip.Tip="{res:Loc recipe.tt.param.var}"/>
                                </Grid>

                                <!-- 默认值 -->
                                <Grid ColumnDefinitions="56,*,56,*,56,*">
                                    <TextBlock Text="{res:Loc recipe.param.default}"
                                               Foreground="{StaticResource HmiTextPrimaryBrush}" FontSize="11"
                                               VerticalAlignment="Center"/>
                                    <TextBox x:Name="TxtParamDefault"
                                             Grid.Column="1"
                                             Background="{StaticResource HmiBgDeepBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                             BorderBrush="{StaticResource HmiInputBorderBrush}" BorderThickness="1"
                                             Padding="6,3" FontSize="12"
                                             PlaceholderText="{res:Loc recipe.param.default.hint}"
                                             ToolTip.Tip="{res:Loc recipe.tt.param.default}"/>

                                    <TextBlock Text="{res:Loc recipe.param.unit}" Grid.Column="2"
                                               Foreground="{StaticResource HmiTextPrimaryBrush}" FontSize="11"
                                               VerticalAlignment="Center"
                                               Margin="4,0,0,0"/>
                                    <TextBox x:Name="TxtParamUnit"
                                             Grid.Column="3"
                                             Background="{StaticResource HmiBgDeepBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                             BorderBrush="{StaticResource HmiInputBorderBrush}" BorderThickness="1"
                                             Padding="6,3" FontSize="12"
                                             PlaceholderText="{res:Loc recipe.param.unit.hint}"
                                             ToolTip.Tip="{res:Loc recipe.tt.param.unit}"/>
                                </Grid>

                                <!-- 最小值 / 最大值 -->
                                <Grid ColumnDefinitions="56,*,56,*">
                                    <TextBlock Text="{res:Loc recipe.param.min}"
                                               Foreground="{StaticResource HmiTextPrimaryBrush}" FontSize="11"
                                               VerticalAlignment="Center"/>
                                    <TextBox x:Name="TxtParamMin"
                                             Grid.Column="1"
                                             Background="{StaticResource HmiBgDeepBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                             BorderBrush="{StaticResource HmiInputBorderBrush}" BorderThickness="1"
                                             Padding="6,3" FontSize="12"
                                             PlaceholderText="{res:Loc trend.min}"
                                             ToolTip.Tip="{res:Loc recipe.tt.param.min}"/>

                                    <TextBlock Text="{res:Loc recipe.param.max}" Grid.Column="2"
                                               Foreground="{StaticResource HmiTextPrimaryBrush}" FontSize="11"
                                               VerticalAlignment="Center"
                                               Margin="4,0,0,0"/>
                                    <TextBox x:Name="TxtParamMax"
                                             Grid.Column="3"
                                             Background="{StaticResource HmiBgDeepBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                             BorderBrush="{StaticResource HmiInputBorderBrush}" BorderThickness="1"
                                             Padding="6,3" FontSize="12"
                                             PlaceholderText="{res:Loc trend.max}"
                                             ToolTip.Tip="{res:Loc recipe.tt.param.max}"/>
                                </Grid>

                                <!-- 数据类型 + 排序号 -->
                                <Grid ColumnDefinitions="56,*,56,*">
                                    <TextBlock Text="{res:Loc recipe.param.type}"
                                               Foreground="{StaticResource HmiTextPrimaryBrush}" FontSize="11"
                                               VerticalAlignment="Center"/>
                                    <ComboBox x:Name="CmbParamDataType"
                                              Grid.Column="1"
                                              Background="{StaticResource HmiBgDeepBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                              BorderBrush="{StaticResource HmiInputBorderBrush}" BorderThickness="1"
                                              Padding="6,3" FontSize="12"
                                              ToolTip.Tip="{res:Loc recipe.tt.param.type}"/>

                                    <TextBlock Text="{res:Loc recipe.param.order}" Grid.Column="2"
                                               Foreground="{StaticResource HmiTextPrimaryBrush}" FontSize="11"
                                               VerticalAlignment="Center"
                                               Margin="4,0,0,0"/>
                                    <TextBox x:Name="TxtParamSortOrder"
                                             Grid.Column="3"
                                             Background="{StaticResource HmiBgDeepBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                             BorderBrush="{StaticResource HmiInputBorderBrush}" BorderThickness="1"
                                             Padding="6,3" FontSize="12"
                                             PlaceholderText="{res:Loc recipe.param.order.hint}"
                                             ToolTip.Tip="{res:Loc recipe.tt.param.order}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 保存按钮 -->
                        <Button x:Name="BtnSaveRecipe" Content="{res:Loc recipe.save}"
                                Background="{StaticResource HmiSuccessDeepBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                BorderThickness="0" Padding="14,6"
                                FontSize="13" HorizontalAlignment="Left"
                                Margin="0,4,0,0"
                                ToolTip.Tip="{res:Loc recipe.tt.save}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Border>

    <!-- 底部状态行：CSV 导入的问题摆在这里（登记 #61f，阶段 100）。
         ⚠ 放在 Border 里、**不套 ScrollViewer** —— 「ScrollViewer 垂直可滚动 ＋ 多行 Wrap
         TextBlock」才是 headless 首次布局不收敛的触发条件（ScrollViewer → Border 即收敛，
         见 docs/2026-09-22-headless-scrollviewer-wrap-hang.md case 6）。
         可见文本限 5 条 ＋ 显式省略号，**全文在 ToolTip 里**（一条不丢）。 -->
    <Border x:Name="CsvIssueBar" Grid.Row="2"
            Background="{StaticResource HmiWarningDeepBrush}"
            Padding="12,4" IsVisible="False">
        <TextBlock x:Name="TxtCsvIssues"
                   Foreground="{StaticResource HmiTextPrimaryBrush}"
                   FontSize="11"
                   TextWrapping="Wrap"/>
    </Border>
        </Grid>
    </Border>
</cw:ChromeWindow>
