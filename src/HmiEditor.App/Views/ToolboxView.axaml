<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:HmiEditor.App.Views"
             xmlns:res="clr-namespace:HmiEditor.App.Resources"
             x:Class="HmiEditor.App.Views.ToolboxView">
    <UserControl.Styles>
        <Style Selector="TextBox:focus">
            <Setter Property="BorderBrush" Value="{StaticResource HmiAccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Button:focus">
            <Setter Property="BorderBrush" Value="{StaticResource HmiAccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </UserControl.Styles>
    <Border Background="{StaticResource HmiBgPanelBrush}" Padding="8">
        <Grid RowDefinitions="Auto,Auto,Auto,*">
            <!-- 搜索框与清除操作 -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                <TextBox x:Name="SearchBox"
                         PlaceholderText="{res:Loc tb.search.hint}"
                         Background="{StaticResource HmiBgInputBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                         PlaceholderForeground="{StaticResource HmiTextHintBrush}"
                         ToolTip.Tip="{res:Loc tb.search.shortcut}"
                         BorderBrush="{StaticResource HmiInputBorderBrush}" BorderThickness="1"
                         CornerRadius="4" Padding="8,6" FontSize="13"
                         TextChanged="OnSearchTextChanged"
                         KeyDown="OnSearchKeyDown"
                         AutomationProperties.Name="{res:Loc tb.search.hint}" />
                <Button x:Name="ClearSearchButton" Grid.Column="1" Content="×"
                        Width="28" Height="30" Padding="0" FontSize="17"
                        ToolTip.Tip="{res:Loc tb.search.clear}"
                         AutomationProperties.Name="{res:Loc tb.search.clear}"
                         IsVisible="False"
                        Click="OnClearSearchClick" />
            </Grid>

            <!-- 控件列表标题与结果计数 -->
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="4,2,0,2">
                <TextBlock Text="{res:Loc tb.controls.list}" Foreground="{StaticResource HmiTextHintBrush}"
                           FontSize="11" />
                <TextBlock x:Name="ResultCountText" Grid.Column="1" Foreground="{StaticResource HmiTextHintBrush}"
                            AutomationProperties.Name="{res:Loc tb.search.count.label}"
                           FontSize="11" />
            </Grid>

            <!-- 搜索无结果空状态 -->
            <Border x:Name="EmptyStateBorder" Grid.Row="2" Background="{StaticResource HmiBgInputBrush}"
                    BorderBrush="{StaticResource HmiInputBorderBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="12" Margin="4" IsVisible="False"
                     AutomationProperties.Name="{res:Loc tb.search.empty}"
                      AutomationProperties.HelpText="{res:Loc tb.search.empty}">
                <Border.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.16"/>
                    </Transitions>
                </Border.Transitions>
                <StackPanel Spacing="4" HorizontalAlignment="Center">
                    <TextBlock Text="⌕" FontSize="22" Foreground="{StaticResource HmiTextHintBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="EmptyStateText"
                               Text="{res:Loc tb.search.empty}"
                               Foreground="{StaticResource HmiTextHintBrush}" FontSize="12"
                               TextWrapping="Wrap" TextAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- 控件列表 -->
            <ListBox Grid.Row="3" x:Name="ToolboxList"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.IsDeferredScrollingEnabled="True"
                     Padding="0,0,0,2"
                     KeyDown="OnToolboxListKeyDown"
                     AutomationProperties.Name="{res:Loc tb.controls.list}">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="4,2"/>
                        <Setter Property="Margin" Value="0,2"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="CornerRadius" Value="6"/>
                        <Setter Property="Transitions">
                            <Transitions>
                                <BrushTransition Property="Background" Duration="0:0:0.12"/>
                                <BrushTransition Property="BorderBrush" Duration="0:0:0.12"/>
                            </Transitions>
                        </Setter>
                    </Style>
                    <Style Selector="ListBoxItem:pointerover">
                        <Setter Property="Background" Value="{StaticResource HmiBgDeepBrush}"/>
                    </Style>
                    <Style Selector="ListBoxItem:selected:pointerover">
                        <Setter Property="Background" Value="{StaticResource HmiBgSelectedBrush}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource HmiAccentHoverBrush}"/>
                        <Setter Property="BorderThickness" Value="1"/>
                    </Style>
                    <Style Selector="ListBoxItem:selected:focus">
                        <Setter Property="BorderBrush" Value="{StaticResource HmiAccentBrush}"/>
                        <Setter Property="BorderThickness" Value="1"/>
                    </Style>
                    <Style Selector="ListBoxItem:selected">
                        <Setter Property="Background" Value="{StaticResource HmiBgSelectedBrush}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource HmiLinkBrush}"/>
                        <Setter Property="BorderThickness" Value="1"/>
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="local:ToolboxItem">
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,2"
                                    ToolTip.Tip="{res:Loc tb.drag.hint}"
                                    AutomationProperties.Name="{Binding DisplayName}">
                            <Path Data="{Binding Icon}"
                                  Width="20" Height="20"
                                  Stretch="Uniform"
                                  Stroke="{StaticResource HmiTextSecondaryBrush}"
                                  StrokeThickness="1.2"
                                  VerticalAlignment="Center" />
                            <StackPanel VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="{Binding DisplayName}"
                                           Foreground="{StaticResource HmiTextPrimaryBrush}" FontSize="13" />
                                <TextBlock Text="{Binding Category}"
                                           Foreground="{StaticResource HmiTextHintBrush}" FontSize="10" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Border>
</UserControl>
