<cw:ChromeWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:HmiEditor.App.Resources"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        xmlns:cw="using:HmiEditor.App.Controls"
        x:Class="HmiEditor.App.Views.VariableImportView"
        Title="{res:Loc win.var.import}"
        Width="800"
        Height="600"
        MinWidth="600"
        MinHeight="450"
        WindowStartupLocation="CenterOwner">
    <!-- ═══ 无边框圆角窗口外壳 ═══ -->
    <Border CornerRadius="{StaticResource HmiWindowCornerRadius}"
            BorderBrush="{StaticResource HmiWindowBorderBrush}"
            BorderThickness="{StaticResource HmiWindowBorderThickness}"
            Background="{StaticResource HmiBgWindowBrush}"
            ClipToBounds="True">
        <Grid RowDefinitions="36,*">
            <!-- 标准标题栏 -->
            <Border Grid.Row="0"
                    CornerRadius="10,10,0,0"
                    Background="{StaticResource HmiWindowTitleBgBrush}"
                    BorderBrush="{StaticResource HmiBorderBrush}"
                    BorderThickness="0,0,0,1"
                    chrome:WindowDecorationProperties.ElementRole="TitleBar"
                    PointerPressed="OnTitleBarPointerPressed">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{res:Loc win.var.import}"
                               Foreground="{StaticResource HmiTextPrimaryBrush}"
                               FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="16,0,8,0"
                               TextTrimming="CharacterEllipsis"/>
                    <Button x:Name="BtnTitleClose"
                            Grid.Column="1"
                            Width="40" Height="36"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource HmiTextSecondaryBrush}"
                            CornerRadius="0,10,0,0"
                            Click="OnTitleCloseClicked"
                            chrome:WindowDecorationProperties.ElementRole="CloseButton">
                        <Path Data="{StaticResource HmiCloseGlyph}"
                              Width="10" Height="10"
                              Stretch="Uniform"
                              Stroke="{StaticResource HmiTextSecondaryBrush}"
                              StrokeThickness="1.5"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    </Button>
                </Grid>
            </Border>

            <!-- 原窗口内容整体放入此处 -->
            <Border Grid.Row="1" Padding="16">
        <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">
            <!-- 标题 -->
            <TextBlock Text="{res:Loc var.import.title}"
                       Foreground="{StaticResource HmiTextPrimaryBrush}" FontSize="20" FontWeight="Bold"
                       Margin="0,0,0,8"/>

            <!-- 文件选择 + 格式说明 -->
            <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,12">
                <Button x:Name="BtnSelectFile"
                        Content="{res:Loc var.import.select.csv}"
                        Background="{StaticResource HmiAccentHoverBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                        BorderThickness="0" Padding="14,6"
                        FontSize="13"/>
                <TextBlock x:Name="FilePathText"
                           Grid.Column="1"
                           Text="{res:Loc var.import.no.file}"
                           Foreground="{StaticResource HmiTextHintBrush}" FontSize="13"
                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                <Button x:Name="BtnParse"
                        Grid.Column="2"
                        Content="{res:Loc var.import.parse}"
                        Background="{StaticResource HmiSuccessDeepBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                        BorderThickness="0" Padding="14,6"
                        FontSize="13"
                        IsEnabled="False"
                        ToolTip.Tip="{res:Loc var.import.tt.parse}"/>
            </Grid>

            <!-- 预览表格 -->
            <Border Grid.Row="2" Background="{StaticResource HmiBgDeepBrush}" CornerRadius="6"
                    BorderThickness="1" BorderBrush="{StaticResource HmiBorderBrush}" Padding="4">
                <Grid RowDefinitions="Auto,*">
                    <Border Background="{StaticResource HmiBgPanelBrush}" Padding="8,6"
                            BorderThickness="0,0,0,1" BorderBrush="{StaticResource HmiBorderBrush}">
                        <Grid ColumnDefinitions="*,100,120,80,60">
                            <TextBlock Text="{res:Loc var.import.col.name}" Foreground="{StaticResource HmiTextSecondaryBrush}" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Text="{res:Loc var.import.col.type}" Grid.Column="1" Foreground="{StaticResource HmiTextSecondaryBrush}" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Text="{res:Loc var.import.col.addr}" Grid.Column="2" Foreground="{StaticResource HmiTextSecondaryBrush}" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Text="{res:Loc var.import.col.unit}" Grid.Column="3" Foreground="{StaticResource HmiTextSecondaryBrush}" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Text="{res:Loc var.import.col.scale}" Grid.Column="4" Foreground="{StaticResource HmiTextSecondaryBrush}" FontSize="12" FontWeight="SemiBold"/>
                        </Grid>
                    </Border>
                    <ListBox x:Name="PreviewList"
                             Grid.Row="1"
                             Background="Transparent"
                             BorderThickness="0">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="8,4"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{StaticResource HmiTextPrimaryBrush}"/>
                                <Setter Property="FontSize" Value="12"/>
                            </Style>
                            <Style Selector="ListBoxItem:nth-child(odd)">
                                <Setter Property="Background" Value="{StaticResource HmiBgDeepBrush}"/>
                            </Style>
                        </ListBox.Styles>
                    </ListBox>
                </Grid>
            </Border>

            <!-- 状态信息 -->
            <TextBlock x:Name="StatusText"
                       Grid.Row="3"
                       Text=""
                       Foreground="{StaticResource HmiTextHintBrush}" FontSize="12"
                       Margin="0,8,0,0"/>

            <!-- 底部按钮 -->
            <StackPanel Grid.Row="4"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8"
                        Margin="0,12,0,0">
                <Button x:Name="BtnImport"
                        Content="{res:Loc var.import.do.import}"
                        Background="{StaticResource HmiAccentHoverBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                        BorderThickness="0" Padding="14,6"
                        FontSize="13"
                        IsEnabled="False"
                        ToolTip.Tip="{res:Loc var.import.tt.add}"/>
                <Button x:Name="BtnCancel"
                        Content="{res:Loc gen.cancel}"
                        Background="{StaticResource HmiNeutralDeepBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                        BorderThickness="0" Padding="14,6"
                        FontSize="13"/>
            </StackPanel>
        </Grid>
    </Border>
        </Grid>
    </Border>
</cw:ChromeWindow>
