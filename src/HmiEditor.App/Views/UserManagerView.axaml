<cw:ChromeWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:HmiEditor.App.Resources"
        xmlns:ctrl="using:HmiEditor.App.Controls"
        xmlns:models="using:HmiEditor.Core.Models.User"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        xmlns:cw="using:HmiEditor.App.Controls"
        x:Class="HmiEditor.App.Views.UserManagerView"
        Title="{res:Loc win.user.manager}"
        Width="800"
        Height="600"
        MinWidth="600"
        MinHeight="450"
        WindowStartupLocation="CenterOwner">
    <!-- ═══ 无边框圆角窗口外壳 ═══ -->
    <Border CornerRadius="{StaticResource HmiWindowCornerRadius}"
            BorderBrush="{StaticResource HmiWindowBorderBrush}"
            BorderThickness="{StaticResource HmiWindowBorderThickness}"
            Background="{StaticResource HmiBgWindowBrush}"
            ClipToBounds="True">
        <Grid RowDefinitions="36,*">
            <!-- 标准标题栏 -->
            <Border Grid.Row="0"
                    CornerRadius="10,10,0,0"
                    Background="{StaticResource HmiWindowTitleBgBrush}"
                    BorderBrush="{StaticResource HmiBorderBrush}"
                    BorderThickness="0,0,0,1"
                    chrome:WindowDecorationProperties.ElementRole="TitleBar"
                    PointerPressed="OnTitleBarPointerPressed">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{res:Loc win.user.manager}"
                               Foreground="{StaticResource HmiTextPrimaryBrush}"
                               FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="16,0,8,0"
                               TextTrimming="CharacterEllipsis"/>
                    <Button x:Name="BtnTitleClose"
                            Grid.Column="1"
                            Width="40" Height="36"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource HmiTextSecondaryBrush}"
                            CornerRadius="0,10,0,0"
                            Click="OnTitleCloseClicked"
                            chrome:WindowDecorationProperties.ElementRole="CloseButton">
                        <Path Data="{StaticResource HmiCloseGlyph}"
                              Width="10" Height="10"
                              Stretch="Uniform"
                              Stroke="{StaticResource HmiTextSecondaryBrush}"
                              StrokeThickness="1.5"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    </Button>
                </Grid>
            </Border>

            <!-- 原窗口内容 -->
            <Border Grid.Row="1" Background="{StaticResource HmiBgWindowBrush}" Padding="12">
        <Grid RowDefinitions="Auto,*">
            <!-- 标题 -->
            <TextBlock Text="{res:Loc user.mgr.title}"
                       Foreground="{StaticResource HmiTextPrimaryBrush}" FontSize="20" FontWeight="Bold"
                       Margin="0,0,0,8"/>

            <!-- 三选项卡 -->
            <TabControl Grid.Row="1"
                        Background="Transparent"
                        BorderThickness="0">
                <TabControl.Styles>
                    <Style Selector="TabControl > TabStrip > TabStripItem">
                        <Setter Property="Background" Value="{StaticResource HmiBgPanelBrush}"/>
                        <Setter Property="Foreground" Value="{StaticResource HmiTextSecondaryBrush}"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="Padding" Value="16,8"/>
                    </Style>
                    <Style Selector="TabControl > TabStrip > TabStripItem:selected">
                        <Setter Property="Background" Value="{StaticResource HmiBgSelectedBrush}"/>
                        <Setter Property="Foreground" Value="{StaticResource HmiTextPrimaryBrush}"/>
                    </Style>
                    <Style Selector="TabControl > TabStrip > TabStripItem:pointerover">
                        <Setter Property="Background" Value="{StaticResource HmiBgPanelAltBrush}"/>
                    </Style>
                </TabControl.Styles>

                <!-- Tab 1: 用户管理 -->
                <TabItem Header="{res:Loc win.user.manager}">
                    <Grid RowDefinitions="*,Auto" ColumnDefinitions="300,*" Margin="0,8,0,0">
                        <!-- 左侧：用户列表 -->
                        <Border Background="{StaticResource HmiBgPanelBrush}" CornerRadius="6" Padding="8">
                            <Grid RowDefinitions="Auto,*">
                                <TextBlock Text="{res:Loc user.mgr.user.list}" Foreground="{StaticResource HmiTextHintBrush}" FontSize="11"
                                           Margin="4,0,0,4"/>
                                <ListBox x:Name="UserList"
                                         SelectionChanged="OnUserSelectionChanged"
                                         Grid.Row="1"
                                         Background="Transparent"
                                         BorderThickness="0">
                                    <ListBox.Styles>
                                        <Style Selector="ListBoxItem">
                                            <Setter Property="Padding" Value="8"/>
                                            <Setter Property="Margin" Value="0,2"/>
                                            <Setter Property="Background" Value="{StaticResource HmiBgPanelBrush}"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource HmiBorderBrush}"/>
                                            <Setter Property="CornerRadius" Value="4"/>
                                        </Style>
                                        <Style Selector="ListBoxItem:selected">
                                            <Setter Property="Background" Value="{StaticResource HmiBgSelectedBrush}"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource HmiAccentHoverBrush}"/>
                                        </Style>
                                    </ListBox.Styles>
                                </ListBox>
                            </Grid>
                        </Border>

                        <!-- 右侧：用户详情 -->
                        <Border Grid.Column="1" Background="{StaticResource HmiBgPanelBrush}" CornerRadius="6" Padding="12"
                                Margin="8,0,0,0">
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                                <TextBlock Text="{res:Loc user.mgr.user.detail}" Foreground="{StaticResource HmiTextHintBrush}" FontSize="11"
                                           Margin="0,0,0,8"/>

                                <!-- 用户名 -->
                                <Grid ColumnDefinitions="80,*" Grid.Row="1" Margin="0,0,0,6">
                                    <TextBlock Text="{res:Loc user.mgr.username}" Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="DetailUsername" Grid.Column="1"
                                               Foreground="{StaticResource HmiTextPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- 显示名 -->
                                <Grid ColumnDefinitions="80,*" Grid.Row="2" Margin="0,0,0,6">
                                    <TextBlock Text="{res:Loc user.mgr.display.name}" Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <TextBox x:Name="DetailDisplayName" Grid.Column="1"
                                             Background="{StaticResource HmiBgInputBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                             BorderBrush="{StaticResource HmiInputBorderBrush}" BorderThickness="1"/>
                                </Grid>

                                <!-- 角色 -->
                                <Grid ColumnDefinitions="80,*" Grid.Row="3" Margin="0,0,0,6">
                                    <TextBlock Text="{res:Loc user.mgr.role}" Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="DetailRoleCombo" Grid.Column="1"
                                              Background="{StaticResource HmiBgInputBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                              BorderBrush="{StaticResource HmiInputBorderBrush}" BorderThickness="1"/>
                                </Grid>

                                <!-- 状态 -->
                                <Grid ColumnDefinitions="80,*" Grid.Row="4" Margin="0,0,0,6">
                                    <TextBlock Text="{res:Loc user.mgr.status}" Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" Grid.Column="1" Spacing="8">
                                        <TextBlock x:Name="DetailEnabled"
                                               Foreground="{StaticResource HmiSuccessBrush}" VerticalAlignment="Center">
                                        <!-- 禁用态（红色）由 classes:.disabled 驱动 -->
                                        <TextBlock.Styles>
                                            <Style Selector="TextBlock.disabled">
                                                <Setter Property="Foreground" Value="{StaticResource HmiDangerBrush}" />
                                            </Style>
                                        </TextBlock.Styles>
                                    </TextBlock>
                                        <TextBlock x:Name="DetailLocked"
                                                   Foreground="{StaticResource HmiDangerBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <!-- 操作按钮 -->
                                <StackPanel Orientation="Horizontal" Grid.Row="5" Spacing="6"
                                            Margin="0,8,0,0">
                                    <Button x:Name="BtnDeleteUser" Content="{res:Loc user.mgr.delete}" Click="OnDeleteUser"
                                            Background="{StaticResource HmiDangerDeepBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                            BorderThickness="0" Padding="12,6" FontSize="12"/>
                                    <Button x:Name="BtnToggleEnabled" Content="{res:Loc user.mgr.disable}" Click="OnToggleEnabled"
                                            Background="{StaticResource HmiWarningBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                            BorderThickness="0" Padding="12,6" FontSize="12">
                                        <!-- 用户禁用态（绿色）由 classes:.user-disabled 驱动 -->
                                        <Button.Styles>
                                            <Style Selector="Button.user-disabled">
                                                <Setter Property="Background" Value="{StaticResource HmiSuccessBrush}" />
                                            </Style>
                                        </Button.Styles>
                                    </Button>
                                    <Button x:Name="BtnResetPassword" Content="{res:Loc user.mgr.reset.pwd}" Click="OnResetPassword"
                                            Background="{StaticResource HmiAccentHoverBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                            BorderThickness="0" Padding="12,6" FontSize="12"/>
                                    <Button x:Name="BtnUnlock" Content="{res:Loc user.mgr.unlock}" Click="OnUnlockUser"
                                            Background="{StaticResource HmiSuccessDeepBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                            BorderThickness="0" Padding="12,6" FontSize="12"
                                            IsVisible="False"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 底部：添加用户区域 -->
                        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{StaticResource HmiBgPanelBrush}"
                                CornerRadius="6" Padding="12" Margin="0,8,0,0">
                            <Grid ColumnDefinitions="Auto,150,150,120,120,Auto" ColumnSpacing="8">
                                <TextBlock Text="{res:Loc user.mgr.add.user}"
                                           Foreground="{StaticResource HmiTextHintBrush}" FontSize="12"
                                           VerticalAlignment="Center"/>
                                <TextBox x:Name="NewUsername" Grid.Column="1"
                                         PlaceholderText="{res:Loc login.user}"
                                         Background="{StaticResource HmiBgInputBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                         BorderBrush="{StaticResource HmiInputBorderBrush}" BorderThickness="1"
                                         FontSize="12"/>
                                <TextBox x:Name="NewPassword" Grid.Column="2"
                                         PlaceholderText="{res:Loc login.pwd}"
                                         Background="{StaticResource HmiBgInputBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                         BorderBrush="{StaticResource HmiInputBorderBrush}" BorderThickness="1"
                                         FontSize="12"/>
                                <TextBox x:Name="NewDisplayName" Grid.Column="3"
                                         PlaceholderText="{res:Loc user.mgr.display.name}"
                                         Background="{StaticResource HmiBgInputBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                         BorderBrush="{StaticResource HmiInputBorderBrush}" BorderThickness="1"
                                         FontSize="12"/>
                                <ComboBox x:Name="NewRoleCombo" Grid.Column="4"
                                          Background="{StaticResource HmiBgInputBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                          BorderBrush="{StaticResource HmiInputBorderBrush}" BorderThickness="1"
                                          FontSize="12"/>
                                <Button x:Name="BtnAddUser" Grid.Column="5" Click="OnAddUser"
                                        Content="{res:Loc user.mgr.add}"
                                        Background="{StaticResource HmiAccentHoverBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                        BorderThickness="0" Padding="16,6"
                                        FontSize="12"/>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- Tab 2: 角色管理 -->
                <TabItem Header="{res:Loc user.mgr.role.tab}">
                    <Grid ColumnDefinitions="260,*" Margin="0,8,0,0">
                        <!-- 左侧：角色列表 -->
                        <Border Background="{StaticResource HmiBgPanelBrush}" CornerRadius="6" Padding="8">
                            <Grid RowDefinitions="Auto,*">
                                <TextBlock Text="{res:Loc user.mgr.role.list}" Foreground="{StaticResource HmiTextHintBrush}" FontSize="11"
                                           Margin="4,0,0,4"/>
                                <ListBox x:Name="RoleList"
                                         SelectionChanged="OnRoleSelectionChanged"
                                         Grid.Row="1"
                                         Background="Transparent"
                                         BorderThickness="0">
                                    <ListBox.Styles>
                                        <Style Selector="ListBoxItem">
                                            <Setter Property="Padding" Value="8"/>
                                            <Setter Property="Margin" Value="0,2"/>
                                            <Setter Property="Background" Value="{StaticResource HmiBgPanelBrush}"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource HmiBorderBrush}"/>
                                            <Setter Property="CornerRadius" Value="4"/>
                                        </Style>
                                        <Style Selector="ListBoxItem:selected">
                                            <Setter Property="Background" Value="{StaticResource HmiBgSelectedBrush}"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource HmiAccentHoverBrush}"/>
                                        </Style>
                                    </ListBox.Styles>
                                </ListBox>
                            </Grid>
                        </Border>

                        <!-- 右侧：角色详情 -->
                        <Border Grid.Column="1" Background="{StaticResource HmiBgPanelBrush}" CornerRadius="6" Padding="12"
                                Margin="8,0,0,0">
                            <ScrollViewer>
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{res:Loc user.mgr.role.detail}" Foreground="{StaticResource HmiTextHintBrush}" FontSize="11"/>

                                    <!-- 角色名称 -->
                                    <Grid ColumnDefinitions="80,*">
                                        <TextBlock Text="{res:Loc user.mgr.role.name}" Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center"/>
                                        <TextBox x:Name="RoleNameBox" Grid.Column="1"
                                                 Background="{StaticResource HmiBgInputBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                                 BorderBrush="{StaticResource HmiInputBorderBrush}" BorderThickness="1"
                                                 IsReadOnly="True"/>
                                    </Grid>

                                    <!-- 等级 -->
                                    <Grid ColumnDefinitions="80,Auto,*">
                                        <TextBlock Text="{res:Loc user.mgr.role.level}" Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="RoleLevelText" Grid.Column="1"
                                                   Foreground="{StaticResource HmiTextPrimaryBrush}" MinWidth="24"
                                                   VerticalAlignment="Center" Margin="8,0"/>
                                        <Slider x:Name="RoleLevelSlider" Grid.Column="2"
                                                Minimum="0" Maximum="15" TickFrequency="1"
                                                IsSnapToTickEnabled="True"/>
                                    </Grid>

                                    <!-- 描述 -->
                                    <Grid ColumnDefinitions="80,*">
                                        <TextBlock Text="{res:Loc user.mgr.role.desc}" Foreground="{StaticResource HmiTextPrimaryBrush}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="RoleDescText" Grid.Column="1"
                                                   Foreground="{StaticResource HmiTextHintBrush}" FontSize="12"
                                                   VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- 权限分组标题 -->
                                    <TextBlock Text="{res:Loc user.mgr.perm}" Foreground="{StaticResource HmiTextHintBrush}" FontSize="11"
                                               Margin="0,8,0,0"/>

                                    <!-- 权限复选框列表 -->
                                    <!-- ⚠ 这 9 枚权限复选框**刻意不接事件**：它们的值由 BtnSaveRole
                                         在保存时一次性读走（GetPermissionsFromUI），而 OnPermissionChanged
                                         本身是**空壳**（首行守卫之后一行都没有）⇒ 接上去也什么都不做，
                                         只会把「看不出来」变成「看着像有事发生」。
                                         第五层 HostButtonEffectUiTests 把它们登记成 9 条
                                         「④ 事件从未订阅」（登记 #66）。 -->
                                    <CheckBox x:Name="PermViewScreen" Content="{res:Loc user.mgr.perm.view.screen}"
                                              Foreground="{StaticResource HmiTextPrimaryBrush}"/>
                                    <CheckBox x:Name="PermOperateControl" Content="{res:Loc user.mgr.perm.op.ctrl}"
                                              Foreground="{StaticResource HmiTextPrimaryBrush}"/>
                                    <CheckBox x:Name="PermEditRecipe" Content="{res:Loc user.mgr.perm.edit.recipe}"
                                              Foreground="{StaticResource HmiTextPrimaryBrush}"/>
                                    <CheckBox x:Name="PermAcknowledgeAlarm" Content="{res:Loc user.mgr.perm.ack.alarm}"
                                              Foreground="{StaticResource HmiTextPrimaryBrush}"/>
                                    <CheckBox x:Name="PermChangeConfig" Content="{res:Loc user.mgr.perm.config}"
                                              Foreground="{StaticResource HmiTextPrimaryBrush}"/>
                                    <CheckBox x:Name="PermManageUsers" Content="{res:Loc user.mgr.perm.manage.user}"
                                              Foreground="{StaticResource HmiTextPrimaryBrush}"/>
                                    <CheckBox x:Name="PermViewAlarmHistory" Content="{res:Loc user.mgr.perm.view.alarm}"
                                              Foreground="{StaticResource HmiTextPrimaryBrush}"/>
                                    <CheckBox x:Name="PermExportData" Content="{res:Loc user.mgr.perm.export}"
                                              Foreground="{StaticResource HmiTextPrimaryBrush}"/>
                                    <CheckBox x:Name="PermDebugMode" Content="{res:Loc user.mgr.perm.debug}"
                                              Foreground="{StaticResource HmiTextPrimaryBrush}"/>

                                    <!-- 搁置报警（阶段 275；契约的权限点 alarm.shelve）——
                                         与「确认报警」分开：搁置会把报警静音，现场要能按角色收放 -->
                                    <CheckBox x:Name="PermShelveAlarm" Content="{res:Loc user.mgr.perm.shelve.alarm}"
                                              Foreground="{StaticResource HmiTextPrimaryBrush}"/>

                                    <Button x:Name="BtnSaveRole" Content="{res:Loc user.mgr.save.role}" Click="OnSaveRole"
                                            Background="{StaticResource HmiAccentHoverBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                            BorderThickness="0" Padding="14,6"
                                            FontSize="12" HorizontalAlignment="Left"
                                            Margin="0,8,0,0"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- Tab 3: 审计日志 -->
                <TabItem Header="{res:Loc user.mgr.audit.tab}">
                    <Grid RowDefinitions="Auto,Auto,*" Margin="0,8,0,0">
                        <!-- 刷新按钮 -->
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                            <Button x:Name="BtnRefreshLog" Content="{res:Loc user.mgr.audit.refresh}" Click="OnRefreshLog"
                                    Background="{StaticResource HmiBgSelectedBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                    BorderThickness="0" Padding="12,6"
                                    FontSize="12"/>
                            <Button x:Name="BtnClearLog" Content="{res:Loc user.mgr.audit.clear}" Click="OnClearLog"
                                    Background="{StaticResource HmiDangerDeepBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                    BorderThickness="0" Padding="12,6"
                                    FontSize="12"/>
                        </StackPanel>

                        <!-- 表头 -->
                        <Border Grid.Row="1" Background="{StaticResource HmiBgSelectedBrush}" CornerRadius="4" Padding="0">
                            <Grid ColumnDefinitions="140,100,100,*,60,80">
                                <TextBlock Text="{res:Loc user.mgr.audit.time}" Foreground="{StaticResource HmiTextHintBrush}" FontSize="11"
                                           Padding="8,6" FontWeight="Bold"/>
                                <TextBlock Text="{res:Loc user.mgr.audit.user}" Grid.Column="1"
                                           Foreground="{StaticResource HmiTextHintBrush}" FontSize="11"
                                           Padding="8,6" FontWeight="Bold"/>
                                <TextBlock Text="{res:Loc user.mgr.audit.action}" Grid.Column="2"
                                           Foreground="{StaticResource HmiTextHintBrush}" FontSize="11"
                                           Padding="8,6" FontWeight="Bold"/>
                                <TextBlock Text="{res:Loc user.mgr.audit.detail}" Grid.Column="3"
                                           Foreground="{StaticResource HmiTextHintBrush}" FontSize="11"
                                           Padding="8,6" FontWeight="Bold"/>
                                <TextBlock Text="{res:Loc user.mgr.audit.result}" Grid.Column="4"
                                           Foreground="{StaticResource HmiTextHintBrush}" FontSize="11"
                                           Padding="8,6" FontWeight="Bold"/>
                                <TextBlock Text="{res:Loc user.mgr.audit.source}" Grid.Column="5"
                                           Foreground="{StaticResource HmiTextHintBrush}" FontSize="11"
                                           Padding="8,6" FontWeight="Bold"/>
                            </Grid>
                        </Border>

                        <!-- 日志列表（虚拟化 ListBox，避免千级条目全量渲染） -->
                        <ListBox x:Name="AuditLogPanel" Grid.Row="2"
                                 Background="{StaticResource HmiBgPanelBrush}"
                                 BorderThickness="0"
                                 CornerRadius="4" Margin="0,2,0,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:AuditLogEntry}">
                                    <Grid ColumnDefinitions="140,100,100,*,60,80" Margin="0,0,0,1">
                                        <TextBlock Text="{Binding Timestamp, Converter={x:Static ctrl:AuditTimestampConverter.Instance}}" Foreground="{StaticResource HmiTextSecondaryBrush}"
                                                   FontSize="11" VerticalAlignment="Center" Margin="8,4"/>
                                        <TextBlock Text="{Binding Username}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                                   FontSize="11" VerticalAlignment="Center" Margin="8,4" Grid.Column="1"/>
                                        <TextBlock Grid.Column="2" Foreground="{StaticResource HmiTextSecondaryBrush}"
                                                   Text="{Binding Action, Converter={x:Static ctrl:AuditActionNameConverter.Instance}}"
                                                   FontSize="11" VerticalAlignment="Center" Margin="8,4"/>
                                        <TextBlock Text="{Binding Detail}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                                   FontSize="11" VerticalAlignment="Center" Margin="8,4" Grid.Column="3"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="4"
                                                   Text="{Binding Success, Converter={x:Static ctrl:AuditResultTextConverter.Instance}}"
                                                   FontSize="11" VerticalAlignment="Center" Margin="8,4"/>
                                        <TextBlock Text="{Binding Source}" Foreground="{StaticResource HmiTextSecondaryBrush}"
                                                   FontSize="11" VerticalAlignment="Center" Margin="8,4" Grid.Column="5"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
            </Border>
        </Grid>
    </Border>
</cw:ChromeWindow>
