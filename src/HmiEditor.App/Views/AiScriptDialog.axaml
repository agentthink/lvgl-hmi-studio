<cw:ChromeWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:HmiEditor.App.Resources"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        xmlns:cw="using:HmiEditor.App.Controls"
        x:Class="HmiEditor.App.Views.AiScriptDialog"
        Width="560" Height="440"
        MinWidth="420"
        MinHeight="330"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Title="{res:Loc win.ai.script}">
    <!-- ═══ 无边框圆角窗口外壳 ═══ -->
    <Border CornerRadius="{StaticResource HmiWindowCornerRadius}"
            BorderBrush="{StaticResource HmiWindowBorderBrush}"
            BorderThickness="{StaticResource HmiWindowBorderThickness}"
            Background="{StaticResource HmiBgWindowBrush}"
            ClipToBounds="True">
        <Grid RowDefinitions="36,*">
            <!-- 标准标题栏 -->
            <Border Grid.Row="0"
                    CornerRadius="10,10,0,0"
                    Background="{StaticResource HmiWindowTitleBgBrush}"
                    BorderBrush="{StaticResource HmiBorderBrush}"
                    BorderThickness="0,0,0,1"
                    chrome:WindowDecorationProperties.ElementRole="TitleBar"
                    PointerPressed="OnTitleBarPointerPressed">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{res:Loc win.ai.script}"
                               Foreground="{StaticResource HmiTextPrimaryBrush}"
                               FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="16,0,8,0"
                               TextTrimming="CharacterEllipsis"/>
                    <Button x:Name="BtnTitleClose"
                            Grid.Column="1"
                            Width="40" Height="36"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource HmiTextSecondaryBrush}"
                            CornerRadius="0,10,0,0"
                            Click="OnTitleCloseClicked"
                            chrome:WindowDecorationProperties.ElementRole="CloseButton">
                        <TextBlock Text="✕" FontSize="12" FontFamily="Segoe UI Symbol, Noto Sans CJK SC"/>
                    </Button>
                </Grid>
            </Border>

            <!-- 原窗口内容 -->
            <DockPanel Grid.Row="1" Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
            <Button x:Name="CancelBtn" Content="{res:Loc ai.cancel}"
                    Background="{StaticResource HmiNeutralDeepBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                    BorderThickness="0" Padding="16,6"/>
            <Button x:Name="GenerateBtn" Content="{res:Loc ai.generate}"
                    Background="{StaticResource HmiAccentHoverBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                    BorderThickness="0" Padding="16,6"/>
        </StackPanel>

        <StackPanel Spacing="10">
            <TextBlock Text="{res:Loc ai.script.func.hint}"
                       Foreground="{StaticResource HmiTextPrimaryBrush}" FontSize="14" FontWeight="SemiBold"/>
            <TextBox x:Name="InputBox"
                     MinHeight="100" MaxHeight="180"
                     Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                     BorderBrush="{StaticResource HmiInputBorderBrush}" FontSize="13"
                     TextWrapping="Wrap" AcceptsReturn="True"
                     PlaceholderText="{res:Loc ai.script.placeholder}"/>
            <TextBlock x:Name="StatusText"
                       Foreground="{StaticResource HmiTextSecondaryBrush}" FontSize="12"
                       TextWrapping="Wrap"/>
            <Border Background="{StaticResource HmiBgInputBrush}" CornerRadius="4" Padding="10,8">
                <StackPanel Spacing="2">
                    <TextBlock Text="{res:Loc ai.script.api.title}" Foreground="{StaticResource HmiLinkBrush}" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Text="{res:Loc ai.script.api.content}"
                               Foreground="{StaticResource HmiTextMutedBrush}" FontSize="11" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </DockPanel>
        </Grid>
    </Border>
</cw:ChromeWindow>
