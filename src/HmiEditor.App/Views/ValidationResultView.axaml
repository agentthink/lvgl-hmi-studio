<cw:ChromeWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:HmiEditor.App.Resources"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        xmlns:cw="using:HmiEditor.App.Controls"
        x:Class="HmiEditor.App.Views.ValidationResultView"
        Title="{res:Loc win.validation.result}"
        Width="680"
        Height="480"
        MinWidth="510"
        MinHeight="360"
        WindowStartupLocation="CenterOwner">
    <!-- ═══ 无边框圆角窗口外壳 ═══ -->
    <Border CornerRadius="{StaticResource HmiWindowCornerRadius}"
            BorderBrush="{StaticResource HmiWindowBorderBrush}"
            BorderThickness="{StaticResource HmiWindowBorderThickness}"
            Background="{StaticResource HmiBgWindowBrush}"
            ClipToBounds="True">
        <Grid RowDefinitions="36,*">
            <!-- 标准标题栏 -->
            <Border Grid.Row="0"
                    CornerRadius="10,10,0,0"
                    Background="{StaticResource HmiWindowTitleBgBrush}"
                    BorderBrush="{StaticResource HmiBorderBrush}"
                    BorderThickness="0,0,0,1"
                    chrome:WindowDecorationProperties.ElementRole="TitleBar"
                    PointerPressed="OnTitleBarPointerPressed">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{res:Loc win.validation.result}"
                               Foreground="{StaticResource HmiTextPrimaryBrush}"
                               FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="16,0,8,0"
                               TextTrimming="CharacterEllipsis"/>
                    <Button x:Name="BtnTitleClose"
                            Grid.Column="1"
                            Width="40" Height="36"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource HmiTextSecondaryBrush}"
                            CornerRadius="0,10,0,0"
                            Click="OnTitleCloseClicked"
                            chrome:WindowDecorationProperties.ElementRole="CloseButton">
                        <Path Data="{StaticResource HmiCloseGlyph}"
                              Width="10" Height="10"
                              Stretch="Uniform"
                              Stroke="{StaticResource HmiTextSecondaryBrush}"
                              StrokeThickness="1.5"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    </Button>
                </Grid>
            </Border>

            <!-- 原窗口内容 -->
            <Border Grid.Row="1" Background="{StaticResource HmiBgWindowBrush}" Padding="12">
        <Grid RowDefinitions="Auto,*,Auto">
            <!-- 摘要 -->
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,0,0,10">
                <TextBlock x:Name="SummaryText" Foreground="{StaticResource HmiTextPrimaryBrush}" FontSize="15"
                           FontWeight="Bold" VerticalAlignment="Center"/>
                <Button x:Name="BtnCopyAll" Content="{res:Loc gen.copy.all}"
                        Grid.Column="2" Margin="0,0,6,0"
                        Background="{StaticResource HmiNeutralDeepBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                        BorderThickness="0" Padding="12,5" FontSize="12"/>
                <Button x:Name="BtnClose" Content="{res:Loc gen.close}"
                        Grid.Column="3"
                        Background="{StaticResource HmiAccentHoverBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                        BorderThickness="0" Padding="12,5" FontSize="12"/>
            </Grid>

            <!-- 问题列表 -->
            <Border Grid.Row="1" CornerRadius="6" Background="{StaticResource HmiBgPanelBrush}" Padding="8">
                <ListBox ScrollViewer.VerticalScrollBarVisibility="Auto"
                    x:Name="FindingsList"
                    BorderThickness="0"
                    Background="Transparent">
                </ListBox>
            </Border>

            <TextBlock x:Name="HintText" Grid.Row="2" Foreground="{StaticResource HmiTextHintBrush}" FontSize="11"
                       Margin="0,8,0,0"
                       Text="{res:Loc msg.validation.notblock}"/>
        </Grid>
            </Border>
        </Grid>
    </Border>
</cw:ChromeWindow>
