<cw:ChromeWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:HmiEditor.App.Resources"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        xmlns:cw="using:HmiEditor.App.Controls"
        x:Class="HmiEditor.App.Views.StylePresetPicker"
        Title="{res:Loc win.style.preset}"
        Width="600"
        Height="480"
        MinWidth="480"
        MinHeight="384"
        WindowStartupLocation="CenterOwner">
    <!-- ═══ 无边框圆角窗口外壳 ═══ -->
    <Border CornerRadius="{StaticResource HmiWindowCornerRadius}"
            BorderBrush="{StaticResource HmiWindowBorderBrush}"
            BorderThickness="{StaticResource HmiWindowBorderThickness}"
            Background="{StaticResource HmiBgWindowBrush}"
            ClipToBounds="True">
        <Grid RowDefinitions="36,*">
            <!-- 标准标题栏 -->
            <Border Grid.Row="0"
                    CornerRadius="10,10,0,0"
                    Background="{StaticResource HmiWindowTitleBgBrush}"
                    BorderBrush="{StaticResource HmiBorderBrush}"
                    BorderThickness="0,0,0,1"
                    chrome:WindowDecorationProperties.ElementRole="TitleBar"
                    PointerPressed="OnTitleBarPointerPressed">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{res:Loc win.style.preset}"
                               Foreground="{StaticResource HmiTextPrimaryBrush}"
                               FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="16,0,8,0"
                               TextTrimming="CharacterEllipsis"/>
                    <Button x:Name="BtnTitleClose"
                            Grid.Column="1"
                            Width="40" Height="36"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource HmiTextSecondaryBrush}"
                            CornerRadius="0,10,0,0"
                            Click="OnTitleCloseClicked"
                            chrome:WindowDecorationProperties.ElementRole="CloseButton">
                        <Path Data="{StaticResource HmiCloseGlyph}"
                              Width="10" Height="10"
                              Stretch="Uniform"
                              Stroke="{StaticResource HmiTextSecondaryBrush}"
                              StrokeThickness="1.5"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    </Button>
                </Grid>
            </Border>

            <!-- 原窗口内容 -->
            <Border Grid.Row="1" Background="{StaticResource HmiBgWindowBrush}" Padding="16">
        <Grid RowDefinitions="Auto,*,Auto">
            <TextBlock Text="{res:Loc style.preset.title}"
                       Foreground="{StaticResource HmiTextPrimaryBrush}" FontSize="20" FontWeight="Bold"
                       Margin="0,0,0,12"/>

            <ItemsControl x:Name="PresetList"
                          Grid.Row="1"
                          Margin="0,0,0,12">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8">
                <Button x:Name="BtnCancel"
                        Content="{res:Loc gen.cancel}"
                        Background="{StaticResource HmiNeutralDeepBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                        BorderThickness="0" Padding="14,6"
                        FontSize="13"/>
            </StackPanel>
        </Grid>
            </Border>
        </Grid>
    </Border>
</cw:ChromeWindow>
