<cw:ChromeWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:HmiEditor.App.Resources"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        xmlns:cw="using:HmiEditor.App.Controls"
        x:Class="HmiEditor.App.Views.TrendConfigView"
        Title="{res:Loc win.trend.config}"
        Width="850"
        Height="600"
        MinWidth="640"
        MinHeight="450"
        WindowStartupLocation="CenterOwner">
    <!-- ═══ 无边框圆角窗口外壳 ═══ -->
    <Border CornerRadius="{StaticResource HmiWindowCornerRadius}"
            BorderBrush="{StaticResource HmiWindowBorderBrush}"
            BorderThickness="{StaticResource HmiWindowBorderThickness}"
            Background="{StaticResource HmiBgWindowBrush}"
            ClipToBounds="True">
        <Grid RowDefinitions="36,*">
            <!-- 标准标题栏 -->
            <Border Grid.Row="0"
                    CornerRadius="10,10,0,0"
                    Background="{StaticResource HmiWindowTitleBgBrush}"
                    BorderBrush="{StaticResource HmiBorderBrush}"
                    BorderThickness="0,0,0,1"
                    chrome:WindowDecorationProperties.ElementRole="TitleBar"
                    PointerPressed="OnTitleBarPointerPressed">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{res:Loc win.trend.config}"
                               Foreground="{StaticResource HmiTextPrimaryBrush}"
                               FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="16,0,8,0"
                               TextTrimming="CharacterEllipsis"/>
                    <Button x:Name="BtnTitleClose"
                            Grid.Column="1"
                            Width="40" Height="36"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource HmiTextSecondaryBrush}"
                            CornerRadius="0,10,0,0"
                            Click="OnTitleCloseClicked"
                            chrome:WindowDecorationProperties.ElementRole="CloseButton">
                        <Path Data="{StaticResource HmiCloseGlyph}"
                              Width="10" Height="10"
                              Stretch="Uniform"
                              Stroke="{StaticResource HmiTextSecondaryBrush}"
                              StrokeThickness="1.5"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    </Button>
                </Grid>
            </Border>

            <!-- 原窗口内容整体放入此处 -->
            <Border Grid.Row="1" Padding="0">
        <Grid ColumnDefinitions="280,*">
            <!-- ════════════════════════════════════════ -->
            <!-- 左侧：趋势配置列表 + 笔配置               -->
            <!-- ════════════════════════════════════════ -->
            <Border Grid.Column="0" Background="{StaticResource HmiBgDeepBrush}" Padding="8">
                <Grid RowDefinitions="Auto,*,Auto,Auto,*,Auto">
                    <!-- 趋势名称列表标题 + 按钮 -->
                    <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,6">
                        <TextBlock Text="{res:Loc trend.config}"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" FontSize="14" FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                        <Button x:Name="BtnAddTrend" Grid.Column="1"
                                Content="＋"
                                Background="{StaticResource HmiAccentHoverBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                BorderThickness="0" Width="28" Height="24"
                                FontSize="14" Padding="0" Margin="0,0,4,0"
                                ToolTip.Tip="{res:Loc trend.tt.add}"/>
                        <Button x:Name="BtnDeleteTrend" Grid.Column="2"
                                Content="✕"
                                Background="{StaticResource HmiDangerDeepBrush}" Foreground="{StaticResource HmiDangerBrush}"
                                BorderThickness="0" Width="28" Height="24"
                                FontSize="12" Padding="0"
                                ToolTip.Tip="{res:Loc trend.tt.del}"/>
                    </Grid>

                    <!-- 趋势列表 -->
                    <ListBox x:Name="TrendList" SelectionChanged="OnTrendSelectionChanged"
                             Grid.Row="1"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,1"/>
                                <Setter Property="Background" Value="{StaticResource HmiBgPanelBrush}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="BorderBrush" Value="{StaticResource HmiBorderBrush}"/>
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                            <Style Selector="ListBoxItem:selected">
                                <Setter Property="Background" Value="{StaticResource HmiBgSelectedBrush}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource HmiAccentHoverBrush}"/>
                            </Style>
                        </ListBox.Styles>
                    </ListBox>

                    <!-- 分隔 -->
                    <Rectangle Grid.Row="2" Height="1" Fill="{StaticResource HmiBorderBrush}" Margin="0,6,0,6"/>

                    <!-- 笔配置标题 + 按钮 -->
                    <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,4">
                        <TextBlock Text="{res:Loc trend.curve.config}"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <Button x:Name="BtnAddPen" Content="{res:Loc trend.add.pen}"
                                Grid.Column="1"
                                Background="{StaticResource HmiAccentHoverBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                BorderThickness="0" Padding="8,3"
                                FontSize="12" Margin="0,0,4,0"
                                ToolTip.Tip="{res:Loc trend.tt.add.pen}"/>
                        <Button x:Name="BtnDeletePen" Grid.Column="2"
                                Content="✕"
                                Background="{StaticResource HmiDangerDeepBrush}" Foreground="{StaticResource HmiDangerBrush}"
                                BorderThickness="0" Width="28" Height="22"
                                FontSize="12" Padding="0"
                                ToolTip.Tip="{res:Loc trend.tt.del.pen}"/>
                    </Grid>

                    <!-- 笔列表 -->
                    <ListBox x:Name="PenList" SelectionChanged="OnPenSelectionChanged"
                             Grid.Row="4"
                             MinHeight="80"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,1"/>
                                <Setter Property="Background" Value="{StaticResource HmiBgPanelBrush}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="BorderBrush" Value="{StaticResource HmiBorderBrush}"/>
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                            <Style Selector="ListBoxItem:selected">
                                <Setter Property="Background" Value="{StaticResource HmiBgSelectedBrush}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource HmiAccentHoverBrush}"/>
                            </Style>
                        </ListBox.Styles>
                    </ListBox>

                    <!-- 选中笔的编辑区 -->
                    <Border Grid.Row="5" Background="{StaticResource HmiBgDeepBrush}" CornerRadius="4" Padding="6" Margin="0,4,0,0">
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                            <TextBlock Text="{res:Loc trend.pen.edit}"
                                       Foreground="{StaticResource HmiTextSecondaryBrush}" FontSize="11"
                                       Margin="0,0,0,4"/>

                            <!-- 标签 -->
                            <Grid Grid.Row="1" ColumnDefinitions="60,*" Margin="0,0,0,3">
                                <TextBlock Text="{res:Loc trend.label}" Foreground="{StaticResource HmiTextPrimarySoftBrush}" FontSize="12"
                                           VerticalAlignment="Center"/>
                                <TextBox x:Name="PenLabelInput"
                                         Grid.Column="1"
                                         Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                         BorderBrush="{StaticResource HmiBorderBrush}" BorderThickness="1"
                                         FontSize="12" Height="24"
                                         Padding="4,0"/>
                            </Grid>

                            <!-- 变量 ID -->
                            <Grid Grid.Row="2" ColumnDefinitions="60,*" Margin="0,0,0,3">
                                <TextBlock Text="{res:Loc trend.var.id}" Foreground="{StaticResource HmiTextPrimarySoftBrush}" FontSize="12"
                                           VerticalAlignment="Center"/>
                                <TextBox x:Name="PenVariableInput"
                                         Grid.Column="1"
                                         Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                         BorderBrush="{StaticResource HmiBorderBrush}" BorderThickness="1"
                                         FontSize="12" Height="24"
                                         Padding="4,0"/>
                            </Grid>

                            <!-- 颜色 -->
                            <Grid Grid.Row="3" ColumnDefinitions="60,*,Auto" Margin="0,0,0,3">
                                <TextBlock Text="{res:Loc trend.color}" Foreground="{StaticResource HmiTextPrimarySoftBrush}" FontSize="12"
                                           VerticalAlignment="Center"/>
                                <ComboBox x:Name="PenColorCombo" SelectionChanged="OnPenColorChanged"
                                          Grid.Column="1"
                                          Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                          BorderBrush="{StaticResource HmiBorderBrush}"
                                          FontSize="12" Height="24">
                                    <ComboBox.Styles>
                                        <Style Selector="ComboBoxItem">
                                            <Setter Property="Padding" Value="4,2"/>
                                        </Style>
                                    </ComboBox.Styles>
                                </ComboBox>
                                <!-- 颜色预览色块 -->
                                <Border x:Name="PenColorPreview"
                                        Grid.Column="2"
                                        Width="20" Height="20"
                                        CornerRadius="3"
                                        Margin="4,0,0,0"
                                        BorderThickness="0"/>
                            </Grid>

                            <!-- 线宽 -->
                            <Grid Grid.Row="4" ColumnDefinitions="60,*" Margin="0,0,0,3">
                                <TextBlock Text="{res:Loc trend.line.width}" Foreground="{StaticResource HmiTextPrimarySoftBrush}" FontSize="12"
                                           VerticalAlignment="Center"/>
                                <TextBox x:Name="PenLineWidthInput"
                                         Grid.Column="1"
                                         Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                         BorderBrush="{StaticResource HmiBorderBrush}" BorderThickness="1"
                                         FontSize="12" Height="24"
                                         Padding="4,0"/>
                            </Grid>

                            <!-- 显示点 -->
                            <Grid Grid.Row="5" ColumnDefinitions="60,*">
                                <TextBlock Text="{res:Loc trend.show.dot}" Foreground="{StaticResource HmiTextPrimarySoftBrush}" FontSize="12"
                                           VerticalAlignment="Center"/>
                                <CheckBox x:Name="PenShowPointsCheck" IsCheckedChanged="OnPenPropertyChanged"
                                          Grid.Column="1"
                                          Foreground="{StaticResource HmiTextPrimaryBrush}"/>
                            </Grid>

                            <!-- Y 轴范围 -->
                            <Grid Grid.Row="6" ColumnDefinitions="60,*,*" Margin="0,4,0,0">
                                <TextBlock Text="{res:Loc trend.y.axis.range}" Foreground="{StaticResource HmiTextPrimarySoftBrush}" FontSize="12"
                                           VerticalAlignment="Center"/>
                                <TextBox x:Name="PenYMinInput"
                                         Grid.Column="1"
                                         Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                         BorderBrush="{StaticResource HmiBorderBrush}" BorderThickness="1"
                                         FontSize="12" Height="24"
                                         Padding="4,0"
                                         PlaceholderText="{res:Loc trend.min}"/>
                                <TextBox x:Name="PenYMaxInput"
                                         Grid.Column="2"
                                         Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                         BorderBrush="{StaticResource HmiBorderBrush}" BorderThickness="1"
                                         FontSize="12" Height="24"
                                         Padding="4,0" Margin="4,0,0,0"
                                         PlaceholderText="{res:Loc trend.max}"/>
                            </Grid>

                            <!-- 启用 -->
                            <Grid Grid.Row="7" ColumnDefinitions="60,*" Margin="0,3,0,0">
                                <TextBlock Text="{res:Loc trend.enabled}" Foreground="{StaticResource HmiTextPrimarySoftBrush}" FontSize="12"
                                           VerticalAlignment="Center"/>
                                <CheckBox x:Name="PenEnabledCheck" IsCheckedChanged="OnPenPropertyChanged"
                                          Grid.Column="1"
                                          Foreground="{StaticResource HmiTextPrimaryBrush}"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ════════════════════════════════════════ -->
            <!-- 右侧：趋势显示区域                       -->
            <!-- ════════════════════════════════════════ -->
            <Border Grid.Column="1" Padding="12">
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- 顶部：趋势名称 + 时间窗口选择 -->
                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                        <TextBlock x:Name="TrendTitle"
                                   Text="{res:Loc trend.chart}"
                                   Foreground="{StaticResource HmiTextPrimaryBrush}" FontSize="18" FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                        <Grid Grid.Column="1" ColumnDefinitions="Auto,Auto" VerticalAlignment="Center">
                            <TextBlock Text="{res:Loc trend.time.window}" Foreground="{StaticResource HmiTextSecondaryBrush}" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox x:Name="TimeWindowCombo" SelectionChanged="OnTimeWindowChanged"
                                      Grid.Column="1"
                                      Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                      BorderBrush="{StaticResource HmiBorderBrush}"
                                      FontSize="12"
                                      Width="90" Height="26">
                                <ComboBox.Styles>
                                    <Style Selector="ComboBoxItem">
                                        <Setter Property="Padding" Value="6,3"/>
                                    </Style>
                                </ComboBox.Styles>
                            </ComboBox>
                        </Grid>
                    </Grid>

                    <!-- 中间：趋势图表显示区 -->
                    <Border Grid.Row="1"
                            Background="{StaticResource HmiBgDeepBrush}"
                            CornerRadius="6"
                            BorderThickness="1"
                            BorderBrush="{StaticResource HmiBorderBrush}">
                        <Grid>
                            <!-- 自定义绘制面板 -->
                            <Control x:Name="ChartPanel"/>

                            <!-- 空状态提示 -->
                            <TextBlock x:Name="ChartEmptyHint"
                                       Text="{res:Loc trend.run.sim}"
                                       Foreground="{StaticResource HmiTextMutedBrush}"
                                       FontSize="16"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                        </Grid>
                    </Border>

                    <!-- 底部：显示选项 + 操作按钮 -->
                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="12"
                                    VerticalAlignment="Center">
                            <CheckBox x:Name="ChkShowLegend" IsCheckedChanged="OnDisplayOptionChanged" Content="{res:Loc trend.legend}"
                                      Foreground="{StaticResource HmiTextPrimarySoftBrush}" FontSize="12"/>
                            <CheckBox x:Name="ChkShowGrid" IsCheckedChanged="OnDisplayOptionChanged" Content="{res:Loc trend.grid}"
                                      Foreground="{StaticResource HmiTextPrimarySoftBrush}" FontSize="12"/>
                            <CheckBox x:Name="ChkShowXAxis" IsCheckedChanged="OnDisplayOptionChanged" Content="{res:Loc trend.x.axis}"
                                      Foreground="{StaticResource HmiTextPrimarySoftBrush}" FontSize="12"/>
                            <CheckBox x:Name="ChkShowYAxis" IsCheckedChanged="OnDisplayOptionChanged" Content="{res:Loc trend.y.axis}"
                                      Foreground="{StaticResource HmiTextPrimarySoftBrush}" FontSize="12"/>
                        </StackPanel>

                        <Button x:Name="BtnToggleRecord"
                                Grid.Column="1"
                                Content="{res:Loc trend.start.record}"
                                Background="{StaticResource HmiSuccessDeepBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                BorderThickness="0" Padding="14,6"
                                FontSize="13">
                            <!-- 记录中（红色）由 classes:.recording 驱动，取代 code-behind 硬改 Background -->
                            <Button.Styles>
                                <Style Selector="Button.recording">
                                    <Setter Property="Background" Value="{StaticResource HmiDangerBrush}" />
                                </Style>
                            </Button.Styles>
                        </Button>

                        <Button x:Name="BtnExportReport"
                                Grid.Column="2"
                                Content="{res:Loc trend.report.btn}"
                                Background="{StaticResource HmiBgSelectedBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                BorderThickness="0" Padding="14,6" Margin="8,0,0,0"
                                FontSize="13"/>

                        <Button x:Name="BtnExportBundle"
                                Grid.Column="3"
                                Content="{res:Loc report.bundle.btn}"
                                Background="{StaticResource HmiBgSelectedBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                BorderThickness="0" Padding="14,6" Margin="8,0,0,0"
                                FontSize="13"/>

                        <Button x:Name="BtnReportDesigner"
                                Grid.Column="4"
                                Content="{res:Loc report.designer.btn}"
                                Background="{StaticResource HmiBgPanelBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                                BorderThickness="0" Padding="14,6" Margin="8,0,0,0"
                                FontSize="13"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
        </Grid>
    </Border>
</cw:ChromeWindow>
