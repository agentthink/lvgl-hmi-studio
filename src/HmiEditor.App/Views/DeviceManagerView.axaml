<cw:ChromeWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:HmiEditor.App.Resources"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        xmlns:cw="using:HmiEditor.App.Controls"
        x:Class="HmiEditor.App.Views.DeviceManagerView"
        Title="{res:Loc device.title}"
        Width="980"
        Height="680"
        MinWidth="820"
        MinHeight="560"
        WindowStartupLocation="CenterOwner">
    <Border CornerRadius="{StaticResource HmiWindowCornerRadius}"
            BorderBrush="{StaticResource HmiWindowBorderBrush}"
            BorderThickness="{StaticResource HmiWindowBorderThickness}"
            Background="{StaticResource HmiBgWindowBrush}"
            ClipToBounds="True">
        <Grid RowDefinitions="36,*">
            <!-- 标题栏 -->
            <Border Grid.Row="0"
                    CornerRadius="10,10,0,0"
                    Background="{StaticResource HmiWindowTitleBgBrush}"
                    BorderBrush="{StaticResource HmiBorderBrush}"
                    BorderThickness="0,0,0,1"
                    chrome:WindowDecorationProperties.ElementRole="TitleBar"
                    PointerPressed="OnTitleBarPointerPressed">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{res:Loc device.title}"
                               Foreground="{StaticResource HmiTextPrimaryBrush}"
                               FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="16,0,8,0"
                               TextTrimming="CharacterEllipsis"/>
                    <Button x:Name="BtnTitleClose"
                            Grid.Column="1"
                            Width="40" Height="36"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource HmiTextSecondaryBrush}"
                            CornerRadius="0,10,0,0"
                            Click="OnTitleCloseClicked"
                            chrome:WindowDecorationProperties.ElementRole="CloseButton">
                        <TextBlock Text="✕" FontSize="12" FontFamily="Segoe UI Symbol, Noto Sans CJK SC"/>
                    </Button>
                </Grid>
            </Border>

            <!-- 内容 -->
            <Grid Grid.Row="1" RowDefinitions="*,150" Margin="12,10,12,12">
                <!-- ═══ 上部：连接 + 操作 ═══ -->
                <Grid Grid.Row="0" ColumnDefinitions="300,10,*">
                    <!-- ── 左：连接与设备信息 ── -->
                    <Border Grid.Column="0" CornerRadius="6" Background="{StaticResource HmiBgPanelBrush}" Padding="12">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="10">
                            <!-- 通道类型 -->
                            <TextBlock Text="{res:Loc device.channel}"
                                       Foreground="{StaticResource HmiTextSecondaryBrush}" FontSize="12"/>
                            <ComboBox x:Name="CmbChannelType" SelectedIndex="0" SelectionChanged="OnChannelTypeChanged"
                                      Foreground="{StaticResource HmiTextPrimaryBrush}">
                                <ComboBoxItem Content="{res:Loc device.channel.serial}"/>
                                <ComboBoxItem Content="{res:Loc device.channel.ethernet}"/>
                            </ComboBox>

                            <!-- 串口 -->
                            <Grid x:Name="SerialPanel" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                <ComboBox x:Name="CmbPort" Grid.Column="0"
                                          Foreground="{StaticResource HmiTextPrimaryBrush}"
                                          PlaceholderText="{res:Loc device.port}"/>
                                <Button x:Name="BtnRefreshPorts" Grid.Column="1" Padding="8,5"
                                        Click="OnRefreshPortsClicked"
                                        ToolTip.Tip="{res:Loc device.refresh.ports}">
                                    <TextBlock Text="⟳" FontSize="13"/>
                                </Button>
                            </Grid>
                            <Grid x:Name="BaudPanel" ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                <TextBlock Text="{res:Loc device.baudrate}"
                                           Foreground="{StaticResource HmiTextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBox x:Name="TxtBaudRate" Grid.Column="1" Text="115200"
                                         Foreground="{StaticResource HmiTextPrimaryBrush}"/>
                            </Grid>

                            <!-- 以太网 -->
                            <StackPanel x:Name="TcpPanel" IsVisible="False" Spacing="6">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                    <TextBlock Text="{res:Loc device.host}"
                                               Foreground="{StaticResource HmiTextSecondaryBrush}" VerticalAlignment="Center"/>
                                    <TextBox x:Name="TxtHost" Grid.Column="1" Text="192.168.1.100"
                                             Foreground="{StaticResource HmiTextPrimaryBrush}"/>
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                    <TextBlock Text="{res:Loc device.tcp.port}"
                                               Foreground="{StaticResource HmiTextSecondaryBrush}" VerticalAlignment="Center"/>
                                    <TextBox x:Name="TxtTcpPort" Grid.Column="1" Text="23"
                                             Foreground="{StaticResource HmiTextPrimaryBrush}"/>
                                </Grid>
                            </StackPanel>

                            <Button x:Name="BtnOpenClose" Content="{res:Loc device.open}"
                                    Click="OnOpenCloseClicked" HorizontalAlignment="Stretch"/>

                            <Border Height="1" Background="{StaticResource HmiBorderBrush}"/>

                            <!-- 设备信息 -->
                            <TextBlock Text="{res:Loc device.info}"
                                       Foreground="{StaticResource HmiTextSecondaryBrush}" FontSize="12"/>
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <TextBlock Text="{res:Loc device.model}"
                                           Foreground="{StaticResource HmiTextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtModel" Grid.Column="1" Text="—"
                                           Foreground="{StaticResource HmiTextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>

                                <TextBlock Grid.Row="1" Text="{res:Loc device.arch}"
                                           Foreground="{StaticResource HmiTextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtArch" Grid.Row="1" Grid.Column="1" Text="—"
                                           Foreground="{StaticResource HmiTextPrimaryBrush}"/>

                                <TextBlock Grid.Row="2" Text="{res:Loc device.kernel}"
                                           Foreground="{StaticResource HmiTextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtKernel" Grid.Row="2" Grid.Column="1" Text="—"
                                           Foreground="{StaticResource HmiTextPrimaryBrush}"/>

                                <TextBlock Grid.Row="3" Text="{res:Loc device.fw}"
                                           Foreground="{StaticResource HmiTextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtFw" Grid.Row="3" Grid.Column="1" Text="—"
                                           Foreground="{StaticResource HmiTextPrimaryBrush}"/>

                                <TextBlock Grid.Row="4" Text="{res:Loc device.hmi.version}"
                                           Foreground="{StaticResource HmiTextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtHmiVer" Grid.Row="4" Grid.Column="1" Text="—"
                                           Foreground="{StaticResource HmiTextPrimaryBrush}"/>
                            </Grid>

                            <Button x:Name="BtnDetect" Content="{res:Loc device.detect}"
                                    Click="OnDetectClicked" HorizontalAlignment="Stretch"/>

                            <Button x:Name="BtnCheckUpdate" Content="{res:Loc device.check.update}"
                                    Click="OnCheckUpdateClicked" HorizontalAlignment="Stretch"/>
                            <TextBlock x:Name="TxtUpdateStatus" TextWrapping="Wrap"
                                       Foreground="{StaticResource HmiTextSecondaryBrush}" FontSize="12"/>
                        </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- ── 右：操作页签 ── -->
                    <TabControl Grid.Column="2" Background="Transparent" BorderThickness="0"
                                Foreground="{StaticResource HmiTextPrimaryBrush}">
                        <TabControl.Styles>
                            <Style Selector="TabControl > TabStrip > TabStripItem">
                                <Setter Property="Background" Value="{StaticResource HmiBgPanelBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource HmiTextSecondaryBrush}"/>
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="Padding" Value="14,7"/>
                            </Style>
                            <Style Selector="TabControl > TabStrip > TabStripItem:selected">
                                <Setter Property="Background" Value="{StaticResource HmiBgSelectedBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource HmiTextPrimaryBrush}"/>
                            </Style>
                            <Style Selector="TabControl > TabStrip > TabStripItem:pointerover">
                                <Setter Property="Background" Value="{StaticResource HmiBgPanelAltBrush}"/>
                            </Style>
                        </TabControl.Styles>

                        <!-- ── HMI 程序更新 ── -->
                        <TabItem Header="{res:Loc device.hmi.update}">
                            <Border CornerRadius="6" Background="{StaticResource HmiBgPanelBrush}" Padding="14" Margin="0,8,0,0">
                                <StackPanel Spacing="10">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                        <TextBlock Text="{res:Loc device.swu.path}"
                                                   Foreground="{StaticResource HmiTextSecondaryBrush}" VerticalAlignment="Center"/>
                                        <TextBox x:Name="TxtHmiSwu" Grid.Column="1"
                                                 Foreground="{StaticResource HmiTextPrimaryBrush}"/>
                                        <Button x:Name="BtnBrowseHmiSwu" Grid.Column="2"
                                                Content="{res:Loc device.browse}"
                                                Click="OnBrowseHmiSwuClicked"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="Auto,*,Auto,*,Auto" ColumnSpacing="8">
                                        <TextBlock Text="{res:Loc device.local.version}"
                                                   Foreground="{StaticResource HmiTextSecondaryBrush}" VerticalAlignment="Center"/>
                                        <TextBox x:Name="TxtLocalVersion" Grid.Column="1" Text="1.0.0"
                                                 Foreground="{StaticResource HmiTextPrimaryBrush}"/>
                                        <TextBlock Grid.Column="2" Text="{res:Loc device.device.version}"
                                                   Foreground="{StaticResource HmiTextSecondaryBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                        <TextBox x:Name="TxtDeviceVersion" Grid.Column="3" IsReadOnly="True" Text="—"
                                                 Foreground="{StaticResource HmiTextSecondaryBrush}"/>
                                        <Button x:Name="BtnUpdateHmi" Grid.Column="4"
                                                Content="{res:Loc device.update.now}"
                                                Click="OnUpdateHmiClicked"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                        <TextBlock Text="{res:Loc device.progress}"
                                                   Foreground="{StaticResource HmiTextSecondaryBrush}" VerticalAlignment="Center"/>
                                        <ProgressBar x:Name="ProgHmi" Grid.Column="1" Minimum="0" Maximum="100" Value="0" Height="14"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </TabItem>

                        <!-- ── 固件刷写 ── -->
                        <TabItem Header="{res:Loc device.firmware.flash}">
                            <Border CornerRadius="6" Background="{StaticResource HmiBgPanelBrush}" Padding="14" Margin="0,8,0,0">
                                <StackPanel Spacing="10">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                        <TextBlock Text="{res:Loc device.fw.swu.path}"
                                                   Foreground="{StaticResource HmiTextSecondaryBrush}" VerticalAlignment="Center"/>
                                        <TextBox x:Name="TxtFwSwu" Grid.Column="1"
                                                 Foreground="{StaticResource HmiTextPrimaryBrush}"/>
                                        <Button x:Name="BtnBrowseFwSwu" Grid.Column="2"
                                                Content="{res:Loc device.browse}"
                                                Click="OnBrowseFwSwuClicked"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                        <Button x:Name="BtnFlashFw" Content="{res:Loc device.flash.now}"
                                                Click="OnFlashFwClicked" HorizontalAlignment="Left"/>
                                        <ProgressBar x:Name="ProgFw" Grid.Column="1" Minimum="0" Maximum="100" Value="0" Height="14" VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Text="{res:Loc device.fw.updating}"
                                               Foreground="{StaticResource HmiTextSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </TabItem>

                        <!-- ── USB 更新包生成 ── -->
                        <TabItem Header="{res:Loc device.usb.package}">
                            <Border CornerRadius="6" Background="{StaticResource HmiBgPanelBrush}" Padding="14" Margin="0,8,0,0">
                                <StackPanel Spacing="10">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                        <TextBlock Text="{res:Loc device.hmi.lib.path}"
                                                   Foreground="{StaticResource HmiTextSecondaryBrush}" VerticalAlignment="Center"/>
                                        <TextBox x:Name="TxtHmiLib" Grid.Column="1"
                                                 Foreground="{StaticResource HmiTextPrimaryBrush}"/>
                                        <Button x:Name="BtnBrowseHmiLib" Grid.Column="2"
                                                Content="{res:Loc device.browse}"
                                                Click="OnBrowseHmiLibClicked"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                        <TextBlock Text="{res:Loc device.output.dir}"
                                                   Foreground="{StaticResource HmiTextSecondaryBrush}" VerticalAlignment="Center"/>
                                        <TextBox x:Name="TxtOutputDir" Grid.Column="1"
                                                 Foreground="{StaticResource HmiTextPrimaryBrush}"/>
                                        <Button x:Name="BtnBrowseOutput" Grid.Column="2"
                                                Content="{res:Loc device.browse}"
                                                Click="OnBrowseOutputClicked"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                        <TextBlock Text="{res:Loc device.local.version}"
                                                   Foreground="{StaticResource HmiTextSecondaryBrush}" VerticalAlignment="Center"/>
                                        <TextBox x:Name="TxtPkgVersion" Grid.Column="1" Text="1.0.0"
                                                 Foreground="{StaticResource HmiTextPrimaryBrush}"/>
                                        <Button x:Name="BtnGenerate" Grid.Column="2"
                                                Content="{res:Loc device.generate}"
                                                Click="OnGenerateClicked"/>
                                    </Grid>
                                    <ProgressBar x:Name="ProgGen" Minimum="0" Maximum="100" Value="0" Height="14"/>
                                    <TextBlock x:Name="TxtGenerateResult" TextWrapping="Wrap"
                                               Foreground="{StaticResource HmiTextSecondaryBrush}" FontSize="12"/>
                                </StackPanel>
                            </Border>
                        </TabItem>

                        <!-- ── FEL 镜像烧录 ── -->
                        <TabItem Header="{res:Loc device.fel.flash}">
                            <Border CornerRadius="6" Background="{StaticResource HmiBgPanelBrush}" Padding="14" Margin="0,8,0,0">
                                <StackPanel Spacing="10">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                        <TextBlock Text="{res:Loc device.fel.tool}"
                                                   Foreground="{StaticResource HmiTextSecondaryBrush}" VerticalAlignment="Center"/>
                                        <TextBox x:Name="TxtFelTool" Grid.Column="1" Text="sunxi-fel"
                                                 Foreground="{StaticResource HmiTextPrimaryBrush}"/>
                                        <Button x:Name="BtnBrowseFelTool" Grid.Column="2"
                                                Content="{res:Loc device.browse}"
                                                Click="OnBrowseFelToolClicked"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                        <TextBlock Text="{res:Loc device.fel.image}"
                                                   Foreground="{StaticResource HmiTextSecondaryBrush}" VerticalAlignment="Center"/>
                                        <TextBox x:Name="TxtFelImage" Grid.Column="1"
                                                 Foreground="{StaticResource HmiTextPrimaryBrush}"/>
                                        <Button x:Name="BtnBrowseFelImage" Grid.Column="2"
                                                Content="{res:Loc device.browse}"
                                                Click="OnBrowseFelImageClicked"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                        <TextBlock Text="{res:Loc device.fel.args}"
                                                   Foreground="{StaticResource HmiTextSecondaryBrush}" VerticalAlignment="Center"/>
                                        <TextBox x:Name="TxtFelArgs" Grid.Column="1" Text="-p spiflash-write 0 {image}"
                                                 Foreground="{StaticResource HmiTextPrimaryBrush}"/>
                                    </Grid>
                                    <TextBlock Text="{res:Loc device.fel.hint}"
                                               Foreground="{StaticResource HmiTextSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                        <Button x:Name="BtnFelFlash" Content="{res:Loc device.flash.now}"
                                                Click="OnFelFlashClicked" HorizontalAlignment="Left"/>
                                        <ProgressBar x:Name="ProgFel" Grid.Column="1" Minimum="0" Maximum="100" Value="0" Height="14" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </TabItem>
                    </TabControl>
                </Grid>

                <!-- ═══ 下部：操作日志 ═══ -->
                <Border Grid.Row="1" CornerRadius="6" Background="{StaticResource HmiBgPanelBrush}" Padding="10" Margin="0,10,0,0">
                    <Grid RowDefinitions="Auto,*">
                        <TextBlock Grid.Row="0" Text="{res:Loc device.log}"
                                   Foreground="{StaticResource HmiTextSecondaryBrush}" FontSize="12" Margin="0,0,0,6"/>
                        <ListBox x:Name="LogBox" Grid.Row="1"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{StaticResource HmiTextPrimaryBrush}"
                                 FontFamily="Cascadia Mono, Noto Sans CJK SC"
                                 FontSize="12"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</cw:ChromeWindow>
