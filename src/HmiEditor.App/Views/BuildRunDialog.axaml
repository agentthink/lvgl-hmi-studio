<cw:ChromeWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:HmiEditor.App.Resources"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        xmlns:cw="using:HmiEditor.App.Controls"
        x:Class="HmiEditor.App.Views.BuildRunDialog"
        Title="{res:Loc win.build.run}"
        Width="760"
        Height="540"
        MinWidth="560"
        MinHeight="400"
        WindowStartupLocation="CenterOwner">
    <!-- ═══ 无边框圆角窗口外壳 ═══ -->
    <Border CornerRadius="{StaticResource HmiWindowCornerRadius}"
            BorderBrush="{StaticResource HmiWindowBorderBrush}"
            BorderThickness="{StaticResource HmiWindowBorderThickness}"
            Background="{StaticResource HmiBgWindowBrush}"
            ClipToBounds="True">
        <Grid RowDefinitions="36,*">
            <!-- 标准标题栏 -->
            <Border Grid.Row="0"
                    CornerRadius="10,10,0,0"
                    Background="{StaticResource HmiWindowTitleBgBrush}"
                    BorderBrush="{StaticResource HmiBorderBrush}"
                    BorderThickness="0,0,0,1"
                    chrome:WindowDecorationProperties.ElementRole="TitleBar"
                    PointerPressed="OnTitleBarPointerPressed">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{res:Loc win.build.run}"
                               Foreground="{StaticResource HmiTextPrimaryBrush}"
                               FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="16,0,8,0"
                               TextTrimming="CharacterEllipsis"/>
                    <Button x:Name="BtnTitleClose"
                            Grid.Column="1"
                            Width="40" Height="36"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource HmiTextSecondaryBrush}"
                            CornerRadius="0,10,0,0"
                            Click="OnTitleCloseClicked"
                            chrome:WindowDecorationProperties.ElementRole="CloseButton">
                        <Path Data="{StaticResource HmiCloseGlyph}"
                              Width="10" Height="10"
                              Stretch="Uniform"
                              Stroke="{StaticResource HmiTextSecondaryBrush}"
                              StrokeThickness="1.5"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    </Button>
                </Grid>
            </Border>

            <!-- 内容 -->
            <Grid Grid.Row="1" Margin="16" RowDefinitions="Auto,Auto,*,Auto,Auto">
                <!-- 状态行 -->
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock x:Name="PhaseText"
                               Text="{res:Loc buildrun.phase.ready}"
                               Foreground="{StaticResource HmiTextPrimaryBrush}"
                               FontSize="14" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="ExitCodeText"
                               Grid.Column="1"
                               Foreground="{StaticResource HmiTextHintBrush}" FontSize="12"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- 进度条 -->
                <ProgressBar x:Name="BuildProgress"
                             Grid.Row="1"
                             Minimum="0" Maximum="100" Value="0"
                             Height="6" Margin="0,8,0,0" CornerRadius="3"/>

                <!-- 输出日志 -->
                <Border Grid.Row="2" Margin="0,10,0,0"
                        Background="{StaticResource HmiBgDeepBrush}"
                        BorderBrush="{StaticResource HmiBorderBrush}"
                        BorderThickness="1" CornerRadius="6"
                        Padding="2">
                    <TextBox x:Name="OutputLog"
                             IsReadOnly="True"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{StaticResource HmiTextPrimaryBrush}"
                             FontSize="12"
                             FontFamily="Consolas, Menlo, monospace"
                             TextWrapping="NoWrap"
                             AcceptsReturn="True"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                </Border>

                <!-- 错误摘要 -->
                <StackPanel x:Name="ErrorPanel" Grid.Row="3" Margin="0,8,0,0" Spacing="2" IsVisible="False">
                    <TextBlock x:Name="ErrorTitle"
                               Text="{res:Loc buildrun.errors.title}"
                               Foreground="{StaticResource HmiDangerBrush}" FontSize="13" FontWeight="Bold"/>
                    <ItemsControl x:Name="ErrorList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="{StaticResource HmiDangerBrush}" FontSize="12"
                                           TextWrapping="Wrap"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- 底部按钮 -->
                <Grid Grid.Row="4" ColumnDefinitions="*,Auto,Auto" Margin="0,12,0,0">
                    <Button x:Name="BtnStop"
                            Grid.Column="1"
                            Content="{res:Loc buildrun.btn.stop}"
                            Background="{StaticResource HmiDangerBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                            BorderThickness="0" Padding="16,6" FontSize="13"
                            Margin="0,0,8,0" IsEnabled="False"
                            Click="OnStopClicked"/>
                    <Button x:Name="BtnClose"
                            Grid.Column="2"
                            Content="{res:Loc buildrun.btn.close}"
                            Background="{StaticResource HmiAccentHoverBrush}" Foreground="{StaticResource HmiTextPrimaryBrush}"
                            BorderThickness="0" Padding="16,6" FontSize="13"
                            IsEnabled="False"
                            Click="OnCloseClicked"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</cw:ChromeWindow>
