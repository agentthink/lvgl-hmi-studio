<!--
  zhishu-hmi 应用图标资源字典

  收纳 MainWindow CommandBar 顶栏 + 绘图工具栏 + Toolbox 所有 30+ 个手写 PathIcon。
  目的：消除 XAML 散落的几何字符串，便于视觉统一与维护。

  使用方式：
    <CommandBarButton.Icon>
        <PathIcon Data="{StaticResource IconNewProject}"/>
    </CommandBarButton.Icon>

  命名规则：Icon<语义名>，与 MainWindow 中的按钮 x:Name 对应（去掉 Btn 前缀）。
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══ 文件组 ═══ -->
    <StreamGeometry x:Key="IconNewProject">M3,2 H9 L12,5 V14 H3 Z M8,2 V5 H11 M5.5,7.5 H9.5 M7.5,5.5 V9.5</StreamGeometry>
    <StreamGeometry x:Key="IconOpenProject">M2,4 H6 L7,5 H14 V13 H2 Z M7,6.5 H12.5 V10.5 H7 Z</StreamGeometry>
    <StreamGeometry x:Key="IconSaveProject">M3,2 H11 L13,4 V14 H3 Z M5,9 H11 V13 H5 Z M9,3 V5 H11</StreamGeometry>
    <StreamGeometry x:Key="IconExportCode">M3,3 H8 V4 H4 V12 H10 V7 H11 V13 H3 Z M8,8 H14 M11,5 L14,8 L11,11</StreamGeometry>

