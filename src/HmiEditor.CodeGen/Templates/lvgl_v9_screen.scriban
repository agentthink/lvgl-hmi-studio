// Auto-generated by HmiEditor — DO NOT EDIT MANUALLY
// Screen: {{ screen.name }}

static lv_obj_t* create_screen_{{ screen.id }}(void) {
    lv_obj_t* screen = lv_obj_create(NULL);
    lv_obj_set_size(screen, {{ screen.width }}, {{ screen.height }});
    {{~ if screen.bg_color ~}}
    lv_obj_set_style_bg_color(screen, lv_color_hex(0x{{ screen.bg_color }}), 0);
    {{~ end ~}}

    {{~ for control in screen.controls ~}}
    // {{ control.name }} ({{ control.type }})
    lv_obj_t* obj_{{ control.id }} = lv_obj_create(screen);
    lv_obj_set_pos(obj_{{ control.id }}, {{ control.x }}, {{ control.y }});
    lv_obj_set_size(obj_{{ control.id }}, {{ control.width }}, {{ control.height }});
    {{~ if control.text ~}}
    lv_label_set_text(obj_{{ control.id }}, "{{ control.text }}");
    {{~ end ~}}
    {{~ if control.bg_color ~}}
    lv_obj_set_style_bg_color(obj_{{ control.id }}, lv_color_hex(0x{{ control.bg_color }}), 0);
    {{~ end ~}}

    {{~ end ~}}

    return screen;
}
