// ── Alarm Check Functions ──

// 按 config_id 在配置表中查找，避免依赖表内位置索引与生成顺序耦合。
// （此前误用 {{forindex}}，Scriban 中应为 {{for.index}}，且嵌套循环内
// 会产生无效索引，导致 cfg 指向错误配置甚至越界。）
static alarm_config_t* _alarm_find_config(uint16_t id) {
    for (uint16_t i = 0; _alarm_configs[i].id != 0; i++) {
        if (_alarm_configs[i].id == id) return (alarm_config_t*)&_alarm_configs[i];
    }
    return NULL;
}

{{~ for group in alarm_groups ~}}
{{~ for alarm in group.alarms ~}}
static void alarm_check_{{alarm.id}}(float current_value) {
    alarm_config_t* cfg = _alarm_find_config({{alarm.id | string.hash | math.abs | % 65536}});
    if (cfg == NULL) return;                    // 配置缺失则安全跳过
    alarm_record_t* rec = &_record_{{alarm.id}};
    uint8_t triggered = 0;

    switch (cfg->condition_type) {
        case 0: triggered = (current_value >= cfg->threshold); break;            // HighLimit
        case 1: triggered = (current_value <= cfg->threshold); break;            // LowLimit
        case 2: triggered = (((uint32_t)current_value) >> cfg->bit_offset) & 1; break; // BitTrigger
        case 3: // StateChange
        case 4: triggered = (fabsf(current_value - cfg->expected_value) > cfg->threshold); break;
    }

    if (triggered) {
        if (rec->state == 0) { // Inactive -> Active
            rec->state = 1;
            rec->trigger_value = current_value;
            rec->occurred_at = lv_tick_get();
            alarm_on_triggered(cfg, rec);
        }
    } else {
        if (rec->state == 1) { // Active -> check auto-return
            if (!cfg->ack_required) {
                rec->state = 3;
                rec->returned_at = lv_tick_get();
                alarm_on_returned(cfg, rec);
            } else {
                rec->state = 2; // Active -> Acknowledged (auto)
                rec->acknowledged_at = lv_tick_get();
            }
        } else if (rec->state == 2) {
            rec->state = 3;
            rec->returned_at = lv_tick_get();
            alarm_on_returned(cfg, rec);
        }
    }
}

{{~ end ~}}
{{~ end ~}}

// ── Alarm Engine Entry ──

void alarm_engine_init(void) {
    // Initialize all records
{{~ for group in alarm_groups ~}}
{{~ for alarm in group.alarms ~}}
    _record_{{alarm.id}} = (alarm_record_t){0};
{{~ end ~}}
{{~ end ~}}
}

void alarm_engine_evaluate(float* var_values, int var_count) {
{{~ for group in alarm_groups ~}}
{{~ for alarm in group.alarms ~}}
    alarm_check_{{alarm.id}}(var_values[{{alarm.var_index}}]);
{{~ end ~}}
{{~ end ~}}
}

uint16_t alarm_get_active_count(void) {
    uint16_t count = 0;
{{~ for group in alarm_groups ~}}
{{~ for alarm in group.alarms ~}}
    if (_record_{{alarm.id}}.state == 1) count++;
{{~ end ~}}
{{~ end ~}}
    return count;
}

uint16_t alarm_acknowledge(uint16_t alarm_id) {
{{~ for group in alarm_groups ~}}
{{~ for alarm in group.alarms ~}}
    if (_record_{{alarm.id}}.config_id == alarm_id && _record_{{alarm.id}}.state == 1) {
        _record_{{alarm.id}}.state = 2;
        _record_{{alarm.id}}.acknowledged_at = lv_tick_get();
        return 1;
    }
{{~ end ~}}
{{~ end ~}}
    return 0;
}
