// ── Alarm State Machine ──
// AlarmState: 0=Inactive, 1=Active, 2=Acknowledged, 3=Returned

typedef struct {
    uint16_t config_id;
    volatile uint8_t state;       // AlarmState
    uint8_t ack_required;         // 0=no, 1=yes
    float trigger_value;
    uint32_t occurred_at;         // tick ms
    uint32_t acknowledged_at;
    uint32_t returned_at;
} alarm_record_t;

// ── Alarm Configs (generated from editor data) ──

