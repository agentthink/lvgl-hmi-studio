{{~ end ~}}

static const alarm_config_t _alarm_configs[] = {
{{~ for group in alarm_groups ~}}
{{~ for alarm in group.alarms ~}}
    {
        .id = {{alarm.id | string.hash | math.abs | % 65536}},
        .name = "{{alarm.name}}",
        .severity = {{alarm.severity_value}},
        .ack_required = {{if alarm.requires_ack}}1{{else}}0{{end}},
        .condition_type = {{alarm.condition_type_value}},
        .threshold = {{alarm.condition.threshold}}f,
        .deadband = {{alarm.condition.deadband}}f,
        .delay_ms = {{alarm.condition.delay_ms}},
