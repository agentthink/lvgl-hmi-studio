    uint8_t ack_required;
    uint8_t condition_type;       // 0=HighLimit,1=LowLimit,2=BitTrigger,3=StateChange,4=Deviation
    float threshold;
    float deadband;
    uint16_t delay_ms;
    uint8_t bit_offset;
    float expected_value;
    int16_t var_index;            // index into variable array (-1 = unbound)
} alarm_config_t;

{{~ for group in alarm_groups ~}}
