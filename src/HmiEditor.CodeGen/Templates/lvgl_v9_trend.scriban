// Auto-generated by HmiEditor — DO NOT EDIT MANUALLY
// Trend Chart: {{trend_charts.size}} charts, {{total_pens}} pens, {{total_points}} max points
// Data Logger: {{datalog_configs.size}} loggers

#include "lvgl.h"
#include <math.h>
#include <stdint.h>

// ── Ring Buffer for Data Logging ──
// Embedded Flash-friendly: no malloc, fixed-size static allocation

#define DATA_LOG_MAX_VARS      16
#define DATA_LOG_MAX_RECORDS   {{max_datalog_records}}

typedef struct {
    uint32_t timestamp_ms;              // tick ms
    float values[DATA_LOG_MAX_VARS];
    uint8_t var_count;
    uint8_t is_valid;                   // data freshness flag
} data_log_sample_t;

// ── Data Logger Instances ──

{{~ for logger in datalog_configs ~}}
static data_log_sample_t _logbuf_{{logger.id}}[{{logger.max_records}}];
static volatile uint16_t _logwr_{{logger.id}} = 0;
static volatile uint16_t _logcnt_{{logger.id}} = 0;
static volatile uint8_t _logfull_{{logger.id}} = 0;
{{~ end ~}}

{{~ for logger in datalog_configs ~}}
void datalog_init_{{logger.id}}(void) {
    _logwr_{{logger.id}} = 0;
    _logcnt_{{logger.id}} = 0;
    _logfull_{{logger.id}} = 0;
    memset(_logbuf_{{logger.id}}, 0, sizeof(_logbuf_{{logger.id}}));
}

void datalog_sample_{{logger.id}}(float* var_values, uint8_t count) {
    data_log_sample_t* s = &_logbuf_{{logger.id}}[_logwr_{{logger.id}}];
    s->timestamp_ms = lv_tick_get();
    s->var_count = (count > DATA_LOG_MAX_VARS) ? DATA_LOG_MAX_VARS : count;
    s->is_valid = 1;
    memcpy(s->values, var_values, s->var_count * sizeof(float));

    _logwr_{{logger.id}}++;
    if (_logwr_{{logger.id}} >= {{logger.max_records}}) {
        _logwr_{{logger.id}} = 0;
        _logfull_{{logger.id}} = 1;
        {{~ if logger.full_policy == "StopWhenFull" ~}}
        return; // stop logging
        {{~ end ~}}
    }

    if (!_logfull_{{logger.id}}) {
        _logcnt_{{logger.id}}++;
    }
}
{{~ end ~}}

// ── Trend Chart Configs ──

{{~ for chart in trend_charts ~}}
static lv_chart_series_t* _series_{{chart.id}}[{{chart.pens.size}}];
static lv_obj_t* _chart_{{chart.id}} = NULL;

void trend_init_{{chart.id}}(lv_obj_t* parent) {
    _chart_{{chart.id}} = lv_chart_create(parent);
    lv_obj_set_size(_chart_{{chart.id}}, LV_PCT(100), LV_PCT(100));
    lv_obj_set_pos(_chart_{{chart.id}}, 0, 0);

    // Chart type: line chart
    lv_chart_set_type(_chart_{{chart.id}}, LV_CHART_TYPE_LINE);

    // Data points for time window: time_window_ms / sample_interval_ms
    lv_chart_set_point_count(_chart_{{chart.id}}, {{chart.max_points}});

    {{~ if chart.show_grid ~}}
    lv_chart_set_div_line_count(_chart_{{chart.id}}, 5, 5);
    {{~ end ~}}

    {{~ if chart.bg_color ~}}
    lv_obj_set_style_bg_color(_chart_{{chart.id}}, {{chart.bg_color_lvgl}}, 0);
    {{~ end ~}}

    // Create series for each pen
    {{~ for pen in chart.pens ~}}
    {{~ if pen.is_enabled ~}}
    _series_{{chart.id}}[{{for.index}}] = lv_chart_add_series(
        _chart_{{chart.id}},
        lv_color_hex(0x{{pen.color | string.strip_start "#"}}),
        LV_CHART_AXIS_PRIMARY_Y
    );
    lv_chart_series_t* ser_{{pen.variable_id | string.replace "." "_"}} = _series_{{chart.id}}[{{for.index}}];
    {{~ end ~}}
    {{~ end ~}}

    // X axis range
    lv_chart_set_range(_chart_{{chart.id}}, LV_CHART_AXIS_PRIMARY_X, 0, {{chart.max_points}});

    // Y axis (auto-range by default)
    lv_chart_set_range(_chart_{{chart.id}}, LV_CHART_AXIS_PRIMARY_Y, 0, 100);

    {{~ if chart.show_x_axis ~}}
    lv_chart_set_axis_tick(_chart_{{chart.id}}, LV_CHART_AXIS_PRIMARY_X,
                           0, 0, {{chart.max_points}} / 5, 1, true, 30);
    {{~ end ~}}
    {{~ if chart.show_y_axis ~}}
    lv_chart_set_axis_tick(_chart_{{chart.id}}, LV_CHART_AXIS_PRIMARY_Y,
                           0, 0, 10, 2, true, 40);
    {{~ end ~}}

    lv_chart_refresh(_chart_{{chart.id}});
}

// ── Update function: push new data point ──

void trend_update_{{chart.id}}(float* var_values, uint8_t count) {
    if (_chart_{{chart.id}} == NULL) return;

    {{~ for pen in chart.pens ~}}
    {{~ if pen.is_enabled ~}}
    lv_chart_series_t* ser_{{pen.variable_id | string.replace "." "_"}} = _series_{{chart.id}}[{{for.index}}];
    lv_chart_set_next_value(
        _chart_{{chart.id}},
        ser_{{pen.variable_id | string.replace "." "_"}},
        var_values[{{for.index}}]
    );
    {{~ end ~}}
    {{~ end ~}}

    lv_chart_refresh(_chart_{{chart.id}});
}
{{~ end ~}}

// ── Trend Engine Entry ──

void trend_engine_init(void) {
{{~ for logger in datalog_configs ~}}
    datalog_init_{{logger.id}}();
{{~ end ~}}
}

void trend_engine_tick(float* var_values, uint8_t var_count) {
    // Sample all data loggers
{{~ for logger in datalog_configs ~}}
    datalog_sample_{{logger.id}}(var_values, var_count);
{{~ end ~}}

    // Update all trend charts
{{~ for chart in trend_charts ~}}
    trend_update_{{chart.id}}(var_values, var_count);
{{~ end ~}}
}

// ── CSV Export (to serial / SD card) ──

void datalog_export_csv_{{logger.id}}(void (*write_fn)(const char*)) {
    uint16_t count = _logfull_{{logger.id}} ? {{logger.max_records}} : _logcnt_{{logger.id}};
    uint16_t start = _logfull_{{logger.id}} ? _logwr_{{logger.id}} : 0;

    // CSV header
    write_fn("timestamp_ms");
{{~ for var_id in logger.variable_ids ~}}
    write_fn(",{{var_id}}");
{{~ end ~}}
    write_fn("\n");

    char buf[128];
    for (uint16_t i = 0; i < count; i++) {
        uint16_t idx = (start + i) % {{logger.max_records}};
        data_log_sample_t* s = &_logbuf_{{logger.id}}[idx];
        if (!s->is_valid) continue;

        snprintf(buf, sizeof(buf), "%lu", (unsigned long)s->timestamp_ms);
        write_fn(buf);
        for (uint8_t j = 0; j < s->var_count; j++) {
            snprintf(buf, sizeof(buf), ",%.3f", s->values[j]);
            write_fn(buf);
        }
        write_fn("\n");
    }
}

{{~ for logger in datalog_configs ~}}
uint16_t datalog_get_count_{{logger.id}}(void) {
    return _logfull_{{logger.id}} ? {{logger.max_records}} : _logcnt_{{logger.id}};
}
{{~ end ~}}
