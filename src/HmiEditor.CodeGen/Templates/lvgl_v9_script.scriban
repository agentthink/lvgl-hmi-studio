#ifdef LV_USE_LUA

#include "lv_lua_bridge.h"

// ── HMI Script API Lua Bindings ──
// These C functions are registered as Lua globals for scripts to call

static int lua_hmi_read(lua_State* L) {
    const char* var_id = luaL_checkstring(L, 1);
    // Read variable value from runtime variable table
    float val = hmi_get_variable_value(var_id);
    lua_pushnumber(L, val);
    return 1;
}

static int lua_hmi_write(lua_State* L) {
    const char* var_id = luaL_checkstring(L, 1);
    lua_Number val = luaL_checknumber(L, 2);
    hmi_set_variable_value(var_id, (float)val);
    return 0;
}

static int lua_hmi_set_control_property(lua_State* L) {
    const char* ctrl_id = luaL_checkstring(L, 1);
    const char* prop = luaL_checkstring(L, 2);
    const char* value = luaL_checkstring(L, 3);
    hmi_set_control_property(ctrl_id, prop, value);
    return 0;
}

// ── User Scripts ──

{{~ for script in scripts ~}}
// Script: {{script.name}} ({{script.category}})
const char* _script_src_{{script.id | string.replace "-" "_"}} =
    "{{script.code | string.replace "\n" "\\n" | string.replace "\"" "\\\"" | string.replace "\t" "\\t" }}";

{{~ end ~}}

// ── Script Initialization ──

void lua_script_init(lua_State* L) {
    // Register HMI API
    lua_register(L, "hmi_read", lua_hmi_read);
    lua_register(L, "hmi_write", lua_hmi_write);
    lua_register(L, "hmi_set_control_property", lua_hmi_set_control_property);

    // Load user scripts
{{~ for script in scripts ~}}
{{~ if script.is_enabled ~}}
    if (luaL_loadstring(L, _script_src_{{script.id | string.replace "-" "_"}}) == 0) {
        lua_pcall(L, 0, LUA_MULTRET, 0);
    }
{{~ end ~}}
{{~ end ~}}
}

// ── Event Dispatch ──
// Called by LVGL control event callbacks

{{~ for binding in bindings ~}}
void dispatch_{{binding.control_id}}_{{binding.event_name | string.downcase}}(lua_State* L) {
    lua_getglobal(L, "{{binding.function_name}}");
    if (lua_isfunction(L, -1)) {
        lua_pcall(L, 0, 0, 0);
    }
}
{{~ end ~}}

#else
