// Auto-generated by HmiEditor — DO NOT EDIT MANUALLY
// Recipe Data: {{recipes.size}} recipes, {{groups.size}} groups

#include "lvgl.h"
#include <string.h>
#include <stdio.h>
#include <stdint.h>

// ── Recipe Model ──
// Each recipe is a set of variable presets stored in Flash sectors

#define MAX_RECIPES           32
#define MAX_RECIPE_ITEMS      64
#define MAX_RECIPE_NAME_LEN   48
#define MAX_VAR_NAME_LEN      32

typedef struct {
    char variable_id[MAX_VAR_NAME_LEN];
    float default_value;
    float min_value;
    float max_value;
    uint8_t sort_order;
} recipe_item_t;

typedef struct {
    char name[MAX_RECIPE_NAME_LEN];
    char group_name[MAX_RECIPE_NAME_LEN];
    uint16_t version;
    uint8_t is_enabled;
    uint8_t is_builtin;
    uint16_t item_count;
    recipe_item_t items[MAX_RECIPE_ITEMS];
} recipe_t;

// ── Recipe Storage ──

static recipe_t _recipe_store[MAX_RECIPES];
static uint16_t _recipe_count = 0;

{{~ for recipe in recipes ~}}
// {{recipe.name}} ({{recipe.group_name}}, v{{recipe.version}})
{{~ end ~}}

// ── Recipe Init ──

void recipe_init(void) {
    memset(_recipe_store, 0, sizeof(_recipe_store));
    _recipe_count = 0;
}

// ── Recipe CRUD ──

int16_t recipe_add(const char* name, const char* group_name) {
    if (_recipe_count >= MAX_RECIPES) return -1;

    // Check duplicate
    for (uint16_t i = 0; i < _recipe_count; i++) {
        if (strcmp(_recipe_store[i].name, name) == 0) return -2;
    }

    recipe_t* r = &_recipe_store[_recipe_count];
    strncpy(r->name, name, MAX_RECIPE_NAME_LEN - 1);
    strncpy(r->group_name, group_name ? group_name : "", MAX_RECIPE_NAME_LEN - 1);
    r->version = 1;
    r->is_enabled = 1;
    r->item_count = 0;

    int16_t idx = _recipe_count;
    _recipe_count++;
    return idx;
}

int16_t recipe_find(const char* name) {
    for (uint16_t i = 0; i < _recipe_count; i++) {
        if (strcmp(_recipe_store[i].name, name) == 0)
            return (int16_t)i;
    }
    return -1;
}

uint8_t recipe_delete(uint16_t index) {
    if (index >= _recipe_count) return 0;
    if (_recipe_store[index].is_builtin) return 0;

    // Shift remaining recipes
    for (uint16_t i = index; i < _recipe_count - 1; i++) {
        _recipe_store[i] = _recipe_store[i + 1];
    }
    _recipe_count--;
    return 1;
}

uint8_t recipe_set_item(uint16_t recipe_idx, uint8_t item_idx,
                        const char* var_id, float value) {
    if (recipe_idx >= _recipe_count || item_idx >= MAX_RECIPE_ITEMS)
        return 0;

    recipe_t* r = &_recipe_store[recipe_idx];
    recipe_item_t* item = &r->items[item_idx];
    strncpy(item->variable_id, var_id, MAX_VAR_NAME_LEN - 1);
    item->default_value = value;
    if (item_idx >= r->item_count) r->item_count = item_idx + 1;
    return 1;
}

// ── Recipe Apply ──
// Apply recipe values to variable array (write to registers)

uint8_t recipe_apply(uint16_t recipe_idx, float* var_values, uint16_t var_count) {
    if (recipe_idx >= _recipe_count) return 0;

    recipe_t* r = &_recipe_store[recipe_idx];
    if (!r->is_enabled) return 0;

    for (uint16_t i = 0; i < r->item_count && i < var_count; i++) {
        var_values[i] = r->items[i].default_value;
    }
    return 1;
}

// ── Recipe Upload/Download ──
// Upload: read recipe from SD card / Flash and populate store
// Download: write recipe values to communication registers

uint8_t recipe_upload(uint16_t recipe_idx, float* reg_values) {
    // Apply recipe values to communication registers
    return recipe_apply(recipe_idx, reg_values, MAX_RECIPE_ITEMS);
}

uint8_t recipe_download(uint16_t recipe_idx, float* reg_values, uint16_t count) {
    // Capture current register values as a new recipe version
    if (recipe_idx >= _recipe_count) return 0;

    recipe_t* r = &_recipe_store[recipe_idx];
    uint16_t items = (count < MAX_RECIPE_ITEMS) ? count : MAX_RECIPE_ITEMS;
    for (uint16_t i = 0; i < items; i++) {
        r->items[i].default_value = reg_values[i];
        r->items[i].sort_order = (uint8_t)i;
    }
    r->item_count = items;
    r->version++;
    return 1;
}

uint16_t recipe_get_count(void) {
    return _recipe_count;
}

const char* recipe_get_name(uint16_t index) {
    if (index >= _recipe_count) return NULL;
    return _recipe_store[index].name;
}

uint16_t recipe_get_version(uint16_t index) {
    if (index >= _recipe_count) return 0;
    return _recipe_store[index].version;
}
