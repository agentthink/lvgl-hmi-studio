#include "lvgl.h"
#include <string.h>
#include <stdint.h>

// ── Security Model ──
// Permission level: 0-15 (Pro-face compatible)
// Roles: Operator(0-3), Engineer(4-7), Administrator(8-15)

#define MAX_USERS            16
#define MAX_ROLES            8
#define MAX_USERNAME_LEN     32
#define MAX_PASSWORD_HASH_LEN 64
#define SESSION_TIMEOUT_MS   28800000  // 8 hours

typedef struct {
    uint8_t level;                          // 0-15
    uint32_t permission_mask;               // Permission bitmask
    const char* name;
} user_role_t;

typedef struct {
    char username[MAX_USERNAME_LEN];
    char password_hash[MAX_PASSWORD_HASH_LEN];
    uint8_t role_index;                     // index into _user_roles[]
    uint8_t is_enabled;
    uint8_t failed_attempts;
    uint8_t is_locked;
} user_profile_t;

typedef struct {
    uint8_t is_active;
    uint8_t user_index;                     // index into _user_profiles[]
    uint32_t login_tick;
    uint32_t last_activity_tick;
} user_session_t;

// ── Roles ──

static const user_role_t _user_roles[] = {
{{~ for role in roles ~}}
    {   // {{role.name}} (Level={{role.level}})
        .level = {{role.level}},
        .permission_mask = {{role.permission_value}},
        .name = "{{role.name}}",
    },
{{~ end ~}}
    {0} // sentinel
};

// ── Users ──

static user_profile_t _user_profiles[MAX_USERS];
static uint8_t _user_count = 0;

{{~ for user in users ~}}
// {{user.username}} ({{user.role_name}})
{{~ end ~}}

static user_session_t _active_session = {0};  // single active session (embedded)

// ── User Management ──

uint8_t user_register(const char* username, const char* password_hash, uint8_t role_index) {
    if (_user_count >= MAX_USERS) return 0;

    // Check duplicate
    for (uint8_t i = 0; i < _user_count; i++) {
        if (strcmp(_user_profiles[i].username, username) == 0) return 0;
    }

    user_profile_t* u = &_user_profiles[_user_count];
    strncpy(u->username, username, MAX_USERNAME_LEN - 1);
    strncpy(u->password_hash, password_hash, MAX_PASSWORD_HASH_LEN - 1);
    u->role_index = role_index;
    u->is_enabled = 1;
    u->failed_attempts = 0;
    u->is_locked = 0;
    _user_count++;
    return 1;
}

// ── Authentication ──

uint8_t user_login(const char* username, const char* password_hash) {
    // Find user
    int8_t idx = -1;
    for (uint8_t i = 0; i < _user_count; i++) {
        if (strcmp(_user_profiles[i].username, username) == 0) {
            idx = i;
            break;
        }
    }
    if (idx < 0) return 0;

    user_profile_t* u = &_user_profiles[idx];

    // Account checks
    if (!u->is_enabled || u->is_locked) return 0;

    // Verify password (constant-time compare recommended for production)
    if (strcmp(u->password_hash, password_hash) != 0) {
        u->failed_attempts++;
        if (u->failed_attempts >= 5) u->is_locked = 1;
        return 0;
    }

    // Success
    u->failed_attempts = 0;
    _active_session.is_active = 1;
    _active_session.user_index = idx;
    _active_session.login_tick = lv_tick_get();
    _active_session.last_activity_tick = lv_tick_get();
    return 1;
}

void user_logout(void) {
    _active_session.is_active = 0;
}

// ── Permission Check ──

uint8_t user_check_permission(uint32_t required_permission) {
    if (!_active_session.is_active) return 0;

    // Session timeout check
    if (lv_tick_get() - _active_session.last_activity_tick > SESSION_TIMEOUT_MS) {
        _active_session.is_active = 0;
        return 0;
    }

    _active_session.last_activity_tick = lv_tick_get();

    user_profile_t* u = &_user_profiles[_active_session.user_index];
    const user_role_t* role = &_user_roles[u->role_index];

    return (role->permission_mask & required_permission) == required_permission;
}

uint8_t user_check_level(uint8_t required_level) {
    if (!_active_session.is_active) return 0;

    user_profile_t* u = &_user_profiles[_active_session.user_index];
    const user_role_t* role = &_user_roles[u->role_index];

    return role->level >= required_level;
}

uint8_t user_get_current_level(void) {
    if (!_active_session.is_active) return 0;
    user_profile_t* u = &_user_profiles[_active_session.user_index];
    return _user_roles[u->role_index].level;
}
