#
# hmi-runtime — zhishu-HMI T113-S3 运行固件（Tina-Linux 软件包）
#
# 集成步骤：
#   1) 将本目录复制到 Tina 源码 package/ 下（保持目录名 hmi-runtime）
#   2) make menuconfig → Applications → hmi-runtime 勾选（并确认 lv_examples/libpng/libfreetype）
#   3) make && pack 产出（按 BOARD，见 tina/build.sh）：
#        BOARD=mq_r      → out/t113-mq_r/tina_t113-mq_r_uart1.img
#        BOARD=bingpi_m2 → out/t113-bingpi_m2/tina_t113-bingpi_m2_uart3.img（WavePI-S6 7 寸）
#
# 构建模型：与 SDK 内 lv_examples 一致 —— Build/Prepare 将应用源码 +
# lvgl/lv_drivers 源码复制到构建目录，Build/Compile 一次性编译链接出
# hmi_runtime 可执行文件（不依赖单独的 liblvgl/liblv_drivers 库）。
#
include $(TOPDIR)/rules.mk
include $(BUILD_DIR)/package.mk

PKG_NAME:=hmi-runtime
PKG_VERSION:=1.0.0
PKG_RELEASE:=1
PKG_LICENSE:=MIT

PKG_BUILD_DIR := $(BUILD_DIR)/$(PKG_NAME)
PKG_INSTALL_DIR := $(PKG_BUILD_DIR)/ipkg-install

# 应用/配置/生成代码目录（build.sh 部署时会拷贝到 src/、src-config/、src-generated/）
HMI_APP_DIR ?= $(CURDIR)/src
HMI_CFG_DIR ?= $(CURDIR)/src-config
HMI_GEN_DIR ?= $(CURDIR)/src-generated
# SDK 内 LVGL 源码位置（v9.5，升级后不再使用 littlevgl-8）
LVGL_SDK_DIR ?= $(TOPDIR)/package/gui/lvgl

# 目标板（应用层 HMI_BOARD_WAVEPI）：由构建环境注入 ——
#   tina/build.sh 按 BOARD 导出 HMI_BOARD_WAVEPI=0|1（mq_r|bingpi_m2），
#   这里转成 -D 传给编译器。不再靠 sed 改写 runtime_config.h（那会污染工作区、
#   使构建不可复现）；未注入时用 board_profile.h 的默认板型。
HMI_BOARD_WAVEPI ?= 1
TARGET_CFLAGS+=-DHMI_BOARD_WAVEPI=$(HMI_BOARD_WAVEPI)

# sunxifb 移植版 G2D 硬件加速依赖 libuapi（原 littlevgl-8/sunxifb.mk 注入）
TARGET_LDFLAGS+=-luapi

define Package/hmi-runtime
  SECTION:=utils
  CATEGORY:=Applications
  TITLE:=zhishu-HMI runtime for Allwinner T113-S3
  DEPENDS:=+libpthread +libfreetype +libpng +libuapi +libopenssl
endef

define Package/hmi-runtime/description
  LVGL 9.5.0 based HMI runtime generated by zhishu-HMI editor.
  Features: Modbus RTU (RS485：mq_r=/dev/ttyS3, WavePI=/dev/ttyS4), Modbus TCP (eth0),
  MQTT telemetry, sunxifb display (G2D), evdev touch.
endef

define Build/Prepare
	# 应用源码
	rm -rf $(PKG_BUILD_DIR)
	mkdir -p $(PKG_BUILD_DIR)/src
	$(CP) $(HMI_APP_DIR)/* $(PKG_BUILD_DIR)/src/
	# LVGL 配置与生成代码（放入 src 根，经 -I 找到 lv_conf.h/tags.h）
	$(CP) $(HMI_CFG_DIR)/* $(PKG_BUILD_DIR)/src/
	$(CP) $(HMI_GEN_DIR)/* $(PKG_BUILD_DIR)/src/
	# LVGL v9 源码（自 package/gui/lvgl 根目录；v9 无独立 lv_drivers，sunxifb 已移植进 app/drivers）
	$(CP) $(LVGL_SDK_DIR) $(PKG_BUILD_DIR)/src/
	rm -rf $(PKG_BUILD_DIR)/src/lvgl/build   # 清理宿主构建产物
	rm -rf $(PKG_BUILD_DIR)/src/lvgl/examples $(PKG_BUILD_DIR)/src/lvgl/demos   # 不编译示例/演示
	rm -rf $(PKG_BUILD_DIR)/src/lvgl/src/draw/sw/blend/helium   # Helium(MVE) 汇编仅 ARMv8.1-M，T113 Cortex-A7 不支持
endef

define Build/Configure
endef

TARGET_CFLAGS+=-I$(PKG_BUILD_DIR)/src
# freetype2/libpng 头文件（LVGL 编译期需要；libfreetype 包安装到 STAGING_DIR）
TARGET_CFLAGS+=-I$(STAGING_DIR)/usr/include -I$(STAGING_DIR)/usr/include/freetype2
# 图片资源路径宏：生成代码 IMG_PATH_<id> = "A:" SIM_ASSET_DIR "/<file>"，
# 运行时 LVGL FS 驱动按 A: 前缀 + 该绝对路径加载。
# 2026-08-14：资源主存 /mnt/UDISK/hmi/assets/（UBIFS 持久，OTA 可更新，
# 首次开机由 S97hmiruntime 从 squashfs 出厂资源同步）；/usr/lib/hmi/assets 仅作
# 镜像内出厂 fallback。设备 root 是 tmpfs overlay，写 /usr/lib/hmi 重启即丢。
# 三层转义（OpenWrt 标准写法）：make 展开 \\\" → \" → shell 解析 \" → gcc 收到 "
# （宏值必须带引号，否则 "A:" /mnt/UDISK/hmi/assets "/x" 语法错误）
TARGET_CFLAGS+=-DSIM_ASSET_DIR=\\\"/mnt/UDISK/hmi/assets\\\"

define Build/Compile
	$(MAKE) -C $(PKG_BUILD_DIR)/src \
		ARCH="$(TARGET_ARCH)" \
		AR="$(TARGET_AR)" \
		CC="$(TARGET_CC)" \
		CXX="$(TARGET_CXX)" \
		CFLAGS="$(TARGET_CFLAGS)" \
		LDFLAGS="$(TARGET_LDFLAGS)" \
		LVGL_SRC=1 \
		LVGL_DIR="$(PKG_BUILD_DIR)/src" \
		all
endef

define Package/hmi-runtime/install
	$(INSTALL_DIR) $(1)/usr/bin
	$(INSTALL_BIN) $(PKG_BUILD_DIR)/src/hmi_runtime $(1)/usr/bin/
	# 本机 TLS 终止代理（阶段 302；契约 §1 拓扑：客户端连回环明文，代理对 broker 走 TLS）
	# 由 S97hmiruntime 按 `mqtt.tls` 的 0/3/4 退出码决定起不起（见 tls_proxy_config.h）
	$(INSTALL_BIN) $(PKG_BUILD_DIR)/src/hmi-tls-proxy $(1)/usr/bin/
	$(INSTALL_BIN) ./files/hmi_ota.sh $(1)/usr/bin/
	# adbd 看护（本镜像没有 procd，rcS 只在开机起一次 adbd，死了无人拉；
	# 由 S97hmiruntime 在开机时拉起，详见该文件注释与 docs/flashing-guide.md）
	$(INSTALL_BIN) ./files/hmi_adbd_watchdog.sh $(1)/usr/bin/
	$(INSTALL_DIR) $(1)/usr/lib/hmi
	$(INSTALL_BIN) $(PKG_BUILD_DIR)/src/libhmi_ui.so $(1)/usr/lib/hmi/
	# Tina libpng 包将 .so 错误安装到 /usr/lib/Qt/，ld.so 搜索不到导致
	# hmi_runtime 启动即崩溃 (libpng12.so.0: No such file or directory)。
	# 从 STAGING_DIR 复制到 /usr/lib/ 并建符号链接 workaround 此 bug。
	$(INSTALL_DIR) $(1)/usr/lib
	$(INSTALL_BIN) $(STAGING_DIR)/usr/lib/libpng12.so.0.56.0 $(1)/usr/lib/
	ln -sf libpng12.so.0.56.0 $(1)/usr/lib/libpng12.so.0
	$(INSTALL_DIR) $(1)/etc/init.d
	$(INSTALL_BIN) ./files/S97hmiruntime $(1)/etc/init.d/
	# 固化开机自启：rc.d 符号链接（否则 init 不自动启动 hmi_runtime）
	$(INSTALL_DIR) $(1)/etc/rc.d
	ln -sf ../init.d/S97hmiruntime $(1)/etc/rc.d/S97hmiruntime
	$(INSTALL_DIR) $(1)/etc/hmi
	$(INSTALL_DATA) ./files/hmi-runtime.conf $(1)/etc/hmi/
	# 中文字体（freetype 加载，CJK fallback）
	# font_cjk_sc.ttf = Noto Sans CJK SC 完整简体中文字体（44810 字符，自工程
	# asset_font_cjk.ttc 提取的 SC face，约 16MB，不入 git）；fangsong.ttf 仅 2699 字子集
	# （缺 主/温/压/文/体 等常见字 → 大量方框），保留仅作兼容回退。
	# 缺失 font_cjk_sc.ttf 时构建不中断：运行时依次回退
	# /mnt/UDISK/hmi/fonts/font_cjk_sc.ttf（可由编辑器部署/手动放入）→ 内嵌 CJK 子集字体；
	# 如需随固件内置，构建前把该文件放入本包 files/ 目录即可。
	$(INSTALL_DIR) $(1)/usr/lib/hmi/fonts
	$(INSTALL_DATA) ./files/fangsong.ttf $(1)/usr/lib/hmi/fonts/
	if [ -f ./files/font_cjk_sc.ttf ]; then \
		$(INSTALL_DATA) ./files/font_cjk_sc.ttf $(1)/usr/lib/hmi/fonts/; \
	else \
		echo "  WARN: files/font_cjk_sc.ttf 缺失 —— 全量中文回退到内嵌子集/UDISK 字体"; \
	fi
	# 工程图片资源（生成代码 IMG_PATH_<id> = A:/usr/lib/hmi/assets/<file>）
	$(INSTALL_DIR) $(1)/usr/lib/hmi/assets
	$(INSTALL_DATA) $(HMI_GEN_DIR)/../src-generated/assets/* $(1)/usr/lib/hmi/assets/ 2>/dev/null || true
endef

$(eval $(call BuildPackage,hmi-runtime))
