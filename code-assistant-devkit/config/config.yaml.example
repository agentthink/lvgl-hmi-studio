# =============================================================
# 代码助手开发套件 · 配置文件模板
# 复制为 config/config.yaml 后生效；所有字段均可被环境变量覆盖
# =============================================================

# 服务监听
host: 127.0.0.1
port: 8000

# 鉴权密钥列表（生产环境用强随机值）
api_keys:
  - dev-key-001
  - dev-key-002

# 运行时数据目录
work_dir: .runtime

# 日志级别：DEBUG / INFO / WARN / ERROR
log_level: INFO
